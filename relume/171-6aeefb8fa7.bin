<style>
.relume-docs-header {
  position: sticky;
  top: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  height: 56px;
  padding: 0 24px;
  box-sizing: border-box;
  font-family: var(--scalar-font);
  background: var(--scalar-background-1);
  border-bottom: 1px solid var(--scalar-border-color);
}
.relume-docs-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  color: var(--scalar-color-1);
  text-decoration: none;
}
.relume-docs-brand img {
  height: 24px;
  width: auto;
}
.relume-docs-badge {
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 500;
  color: #34002f;
  background: #ff79ff;
}
.relume-docs-link {
  font-size: 14px;
  font-weight: 500;
  color: var(--scalar-color-2);
  text-decoration: none;
}
.relume-docs-link:hover {
  color: var(--scalar-color-accent);
}
.relume-logo-dark,
.dark-mode .relume-logo-light {
  display: none;
}
.dark-mode .relume-logo-dark {
  display: block;
}
</style>
</head>
