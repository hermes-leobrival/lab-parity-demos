    <div id="d3e9a209-d360-415b-9ecb-3a4664aa30a2" data-sid="c" class="page-section"><section class="scheme-3 section section-100vh bg-s6z8vu"><div class="container z-index-1"><div style="display: contents"><div class="stack"><div class="stack gap-element-tiny"><h1 data-cid="e" data-props='{"headingTag":"H1","headingSize":"H1","headingText":"Every interaction coached for your lifestyle","contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h1" data-bind='{"text":"headingText"}'>Every interaction coached for your lifestyle</h1></div><div class="stack gap-element-xlarge"><div class="stack gap-element-large"><div class="stack"><p data-cid="f" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Curalo is personal training built around you. Tailored coaching that helps you get stronger, healthier and more confident."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Curalo is personal training built around you. Tailored coaching that helps you get stronger, healthier and more confident.</p></div><div class="r-g"><div class="button-group"><a data-cid="i" data-props='{"buttonHierarchy":"Primary","buttonSize":"Regular","buttonHasLeadingIcon":false,"buttonLeadingIcon":"category","buttonHasTrailingIcon":false,"buttonTrailingIcon":"arrow_forward","buttonLabel":"Book a Consultation","buttonLink":"","$index":0,"$count":2}' class="button" data-bind='{"attrs":{"href":"buttonLink"}}'><div style="margin: 0">Book a Consultation</div></a><a data-cid="j" data-props='{"buttonHierarchy":"Secondary","buttonSize":"Regular","buttonHasLeadingIcon":false,"buttonLeadingIcon":"category","buttonHasTrailingIcon":false,"buttonTrailingIcon":"arrow_forward","buttonLabel":"Pricing options","buttonLink":"/#sc-pricing-section-list-vertical","$index":1,"