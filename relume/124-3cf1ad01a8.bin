.fs-cc-prefs_content{-webkit-overflow-scrolling: touch}
</style></div></div></form><div class="w-form-done"></div><div class="w-form-fail"></div><div fs-cc="close" class="fs-cc-prefs_overlay"></div><div fs-cc="interaction" class="fs-cc-prefs_trigger"></div></div></div></footer></div><div data-composer-sticky="" aria-hidden="true" class="p-composer_sticky"><div data-relume-intake="root" class="p-composer_wrapper is-collapsed"><div class="p-composer_form_component w-form"><form id="email-form" name="email-form" data-name="Email Form" method="get" class="p-composer_form is-collapsed" data-wf-page-id="6a7e0020ee3a9a26146b7924" data-wf-element-id="10f98467-ad80-bb42-a63c-2f7ad86b5345" data-wf-locale-id="67d12cda4f07027b560022d9"><textarea data-relume-intake="prompt" class="p-composer_form-input is-collapsed w-input" maxlength="5000" name="brief" data-name="brief" placeholder="Describe the site you need, and watch Relume build it" id="brief"></textarea><div class="p-composer_actions is-collapsed"><div class="p-composer_right-actions"><div data-composer-products="" role="tablist" class="p-composer_switch is-compact"><div title="Publish" aria-label="Relume Publish" aria-selected="true" tabindex="0" role="tab" data-composer-product="publish" class="p-composer_switch-tab is-active"><div class="p-composer_switch-icon is-publish"></div><div class="p-composer_switch-label">Publish</div></div><div title="Export" aria-label="Relume Export" aria-selected="false" tabindex="0" role="tab" data-composer-product="export" class="p-composer_switch-tab"><div class="p-composer_switch-icon is-export"></div><div class="p-composer_switch-label">Export</div></div></div><div data-relume-intake="submit" class="p-intake-hook"><button STYLE="" aria-hidden="true" id="" class="p-button is-ai"><div class="p-button-text">Generate</div></button></div></div></div></form><div class="form_message-success-wrapper w-form-done"><div class="form_message-success"><div>Thank you! Your submission has been received!</div></div></div><div class="form_message-error-wrapper w-form-fail"><div class="form_message-error"><div>Oops! Something went wrong while submitting the form.</div></div></div></div></div></div><div data-example-prompts="" class="w-dyn-list"><div class="w-dyn-empty"><div>No items found.</div></div></div><div class="w-embed w-script"><script>
/* Scopes Relume-Icons-Ext by CONTENT (these names are unique on the
   page) rather than by class, because the icon text nodes are String
   nodes whose parent element is not addressable through the page API.

   It also sets two icons whose elements cannot be targeted directly:
   the second engine card sits inside a component instance, and the
   voting card's icon shares its text with two collaboration cards.
   Both are matched by their card HEADING, never by DOM position - an
   earlier attempt to identify icons by document offset put the wrong
   glyph on a collaboration card. */
(function () {
  var EXT = { "icon-edit": 1, "icon-system": 1, "icon-graph-increase": 1 };
  /* heading prefix -> icon that card should carry */
  var BY_HEADING = [
    [/^Assembled, not generated/, "icon-system"],
    [/^Decide what we built next/, "icon-button"]
  ];
  function heading(el) {
    var n = el;
    for (var i = 0; i < 8 && n; i++) {
      n = n.parentElement; if (!n) break;
      var h = n.querySelector("h1,h2,h3,h4");
      if (h) return (h.textContent || "").trim();
    }
    return "";
  }
  function apply() {
    var icons = document.querySelectorAll(".p-icon");
    for (var i = 0; i < icons.length; i++) {
      var el = icons[i], t = (el.textContent || "").trim(), hd = null;
      for (var j = 0; j < BY_HEADING.length; j++) {
        if (t === BY_HEADING[j][1]) break;      /* already correct */
        if (hd === null) hd = heading(el);
        if (BY_HEADING[j][0].test(hd)) { el.textContent = t = BY_HEADING[j][1]; break; }
      }
      if (EXT[t]) el.setAttribute("data-icon-ext", "1");
      else el.removeAttribute("data-icon-ext");
    }
  }
  apply();
  document.addEventListener("DOMContentLoaded", apply);
  window.addEventListener("load", apply);
})();
</script></div><div class="w-embed"><style>
/* ===== HOUSEKEEPING PASS ==================================
   The logo-strip marquee rebuild that used to live here is gone. It
   wrapped .logo3_component in a new flex rail, which broke the
   wrapper's layout - caption overlapping the logos, edge gradients
   lost. The strip is back on its original mechanism.
   ========================================================== */

/* Logo caption was a hard-coded #5c5c5c primitive, so it never
   switched with the theme. Same value in light mode. */
.logo_text{color:var(--_publish-colors---foreground--secondary)!important}

/* Footer "New" badge, per Figma 209:9003 - success-subtle chip, 4px
   radius, 6px inline padding, Geist Mono 11/18 uppercase at -0.22px.
   Tokens rather than the literal #d5f89d/#101010 so dark mode holds. */
.p-footer_badge-new{
  background-color:var(--_publish-colors---background--success-subtle)!important;
  border-radius:4px!important;padding:0 6px!important;
  display:flex!important;align-items:center!important;justify-content:center!important;
}
.p-footer_badge-new > *{
  font-family:"Geist Mono",ui-monospace,monospace!important;
  font-size:11px!important;line-height:18px!important;
  letter-spacing:-0.22px!important;text-transform:uppercase!important;
  font-weight:500!important;
  color:var(--_publish-colors---foreground--primary)!important;
}

/* Footer link underline for the badge variant.
   Copied from the real implementation - a[data-anim-dotlink] in
   relume-anim-v22.css - not reinvented. The attribute selector needs
   an <a>, and the ::after must not run under the chip, so the same
   declarations are hung on the TEXT child instead:
     - dot gradient + 3.4px/2px tile, identical values
     - bottom: var(--ra-dot-bottom, -0.16em), the per-link value that
       script measures from the text baseline, so there is no vertical
       shift against the neighbouring links
     - opacity 0 -> 1, AND ra-dotlink-march 700ms linear infinite,
       which is the travelling-dots animation this was missing
     - hover colour goes to foreground--primary like the real dotlinks,
       not the --secondary the plain .p-footer_link:hover sets
   ra-dotlink-march is already defined globally in that stylesheet, so
   it is referenced rather than redeclared. */
.p-footer_link.has-badge > div:first-child{
  position:relative;
  text-decoration:none!important;
}
.p-footer_link.has-badge > div:first-child::after{
  content:"";position:absolute;left:0;right:0;
  bottom:var(--ra-dot-bottom,-0.16em);
  height:2px;
  background-image:radial-gradient(circle,
    var(--_publish-colors---borders--accent,#ff00f4) .84px,
    rgba(0,0,0,0) .9px);
  background-size:3.4px 2px;
  opacity:0;
  transition:opacity .15s ease-out;
  pointer-events:none;
}
.p-footer_link.has-badge:hover > div:first-child::after{
  opacity:1;
  animation:ra-dotlink-march 700ms linear infinite;
}
.p-footer_link.has-badge:hover{
  color:var(--_publish-colors---foreground--primary);
}
/* Matches the stylesheet's own reduced-motion rule: dots still show,
   they just stop travelling. */
@media (prefers-reduced-motion:reduce){
  .p-footer_link.has-badge:hover > div:first-child::after{animation:none!important}
}

/* Footer heart beats. Targeted structurally - it is the only icon in
   .p-footer_details-wrapper, beside "Building with love from around
   the globe". Earlier script-based attempts hit the CARD hearts, then
   nothing at all, because this glyph is icon-heart-FILLED. */
@keyframes rl-heartbeat{
  0%,60%,100%{transform:scale(1)}
  8%{transform:scale(1.18)}
  16%{transform:scale(1)}
  24%{transform:scale(1.12)}
  32%{transform:scale(1)}
}
.p-footer_details-wrapper .p-icon{
  display:inline-block;transform-origin:center;
  animation:rl-heartbeat 2.4s ease-in-out infinite;
}
@media (prefers-reduced-motion:reduce){
  .p-footer_details-wrapper .p-icon{animation:none}
}

/* Social icons pick up the same lift the buttons use on hover. */
.p-footer_social-link{
  transition:transform .15s ease-out,color .15s ease-out!important;
  transform-origin:center;
}
.p-footer_social-link:hover{transform:scale(1.18)}
.p-footer_social-link:active{transform:scale(1.04)}
@media (prefers-reduced-motion:reduce){.p-footer_social-link:hover{transform:none}}
</style></div><div class="w-embed"><style>
/* Restore the native pointer after removing RelumeCursor.

   The custom cursor hid the real one so its own arrow could stand in.
   With the script gone the hiding remained - measured cursor:none on
   .icon-tagline_card, inherited from an ancestor carrying
   .cursor-wrap.is-cursor-none - which would have left users with no
   pointer at all over the cards. That is worse than the bug being
   fixed, so it is put back explicitly.

   Scoped to this page's embed, so other pages that still use the
   custom cursor are unaffected. */
