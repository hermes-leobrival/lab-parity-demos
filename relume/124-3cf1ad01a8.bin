<!-- YouTube Video -->
<!-- Non-render-blocking: only rich-text pages with a YouTube embed use it. -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.3/src/lite-yt-embed.css" media="print" onload="this.media='all'">
<script defer src="https://cdn.jsdelivr.net/npm/lite-youtube-embed@0.3.3/src/lite-yt-embed.js"></script>

<style>
  /* Wrapper adds border, radius and crops overflow */
  .yt-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(22,22,22,0.15); /* 15% opacity border */
  }

  /* LiteYT slightly oversized to eliminate 1px bands */
  .yt-wrapper lite-youtube {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: calc(100% + 2px); /* fix 431→432 visual gap */
    display: block;
    background-size: cover;
    background-position: center;
    border: none;
    border-radius: inherit;
    max-width: none !important;
  }

  /* Remove Lite YouTube overlays */
  .yt-wrapper lite-youtube::before,
  .yt-wrapper lite-youtube::after {
    background: none !important;
    box-shadow: none !important;
  }

  .yt-wrapper lite-youtube .lty-title { display: none !important; }
</style>

<script>
  // Helper: choose best available thumbnail
  async function setBestThumb(el, id) {
    const candidates = [
      `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`,
      `https://i.ytimg.com/vi/${id}/sddefault.jpg`,
      `https://i.ytimg.com/vi/${id}/hqdefault.jpg`
    ];
    for (const url of candidates) {
      const ok = await new Promise(res => {
        const img = new Image();
        img.onload = () => res(true);
        img.onerror = () => res(false);
        img.src = url + (url.includes('?') ? '&' : '?') + 't=' + Date.now();
      });
      if (ok) {
        el.style.backgroundImage = `url("${url}")`;
        el.style.backgroundSize = 'cover';
        el.style.backgroundPosition = 'center';
        return;
      }
    }
  }

  // Reapply thumbnail if LiteYT resets style
  function guardBackground(el, id) {
    const obs = new MutationObserver(() => setBestThumb(el, id));
    obs.observe(el, { attributes: true, attributeFilter: ['style'] });
    setTimeout(() => setBestThumb(el, id), 50);
    setTimeout(() => setBestThumb(el, id), 300);
    setTimeout(() => setBestThumb(el, id), 1000);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const created = [];

    document.querySelectorAll('.w-richtext').forEach(rte => {
      rte.querySelectorAll('iframe[src*="youtube.com"],iframe[src*="youtu.be"]').forEach(iframe => {
        try {
          const src = iframe.getAttribute('src') || '';
          let id = (src.match(/\/embed\/([a-zA-Z0-9_-]+)/) || [])[1];
          if (!id) {
            const u = new URL(src, location.origin);
            id = u.searchParams.get('v') || (u.hostname.includes('youtu.be') ? u.pathname.split('/').pop() : '');
          }
          if (!id) return;

          const lite = document.createElement('lite-youtube');
          lite.setAttribute('videoid', id);

          // ✅ Show timeline/controls during playback
          lite.setAttribute(
            'params',
            'modestbranding=1&rel=0&playsinline=1&controls=1&iv_load_policy=3&wmode=transparent&fs=1'
          );

          lite.style.aspectRatio = '16/9';

          // Wrap to add border + overscan
          const wrapper = document.createElement('div');
          wrapper.className = 'yt-wrapper';
          wrapper.appendChild(lite);
          iframe.replaceWith(wrapper);

          created.push({ el: lite, id });
        } catch (e) { console.warn(e); }
      });
    });

    // Wait for component definition, then set HD thumbs
    if ('customElements' in window && customElements.whenDefined) {
      customElements.whenDefined('lite-youtube').then(() => {
        created.forEach(({ el, id }) => { setBestThumb(el, id); guardBackground(el, id); });
      });
    } else {
      created.forEach(({ el, id }) => { setBestThumb(el, id); guardBackground(el, id); });
    }
  });
</script>

<script defer src="/app/_account/landing-page-tracker.js"></script>


<!-- ===== Accessibility repairs (2026-10-23) ===================================
     Runs at the end of <body>, before DOMContentLoaded, so every later script
     sees the repaired markup. Nothing here changes how anything looks.

     1. BUTTON COMPONENT. Publish / Button renders its root with aria-hidden="true"
        (the "Aria Hidden Value" prop defaults to true) and an EMPTY overlay
        <a class="p-button-link"> as the real control. That hid every button from
        screen readers while leaving it focusable, and left the link with no name.
        Now: the overlay link gets the button's text as its name, aria-hidden moves
        from the root onto the visual children, and a <button> root that wraps a
        link becomes a <div> (a link inside a button is invalid and was a second
        tab stop). A root with no overlay link IS the control (e.g. the composer's
        Generate submit), so it simply stops being hidden.
     2. relume-anim's text-effect puts aria-label on plain <div>s, which ARIA
        forbids. The label moves into a visually hidden span; the per-character
        spans were already aria-hidden.
     3. The Finsweet cookie banner's close control has no name.
     4. Icon-only links (logos, socials) get names from their destination.
     5. The composer's sticky clone is aria-hidden while parked off screen but its
        fields stay focusable; it is made inert for exactly as long as it is
        aria-hidden, so keyboard users never tab into an invisible form.
     6. The Publish/Export hero mocks (Webflow code components) use Radix tab lists
        as navigation with no tab panels, so every tab's aria-controls points at
        an id that never exists. aria-controls is optional; a dangling one is
        invalid, so it is dropped. Real fix: render Tabs.Content or omit the
        attribute in the component source.
     7. relume-anim's avatar hover card builds its profile link (a.ra-hc__link)
        with no href and only fills one in when the hovered member has a link, so
        an href-less <a> sits in the page and fails "links are not crawlable".
        While it has no destination it is marked role="none" (it is also hidden);
        the moment relume-anim gives it an href the role is removed again.
     8. The Publish shot (.cpp, choose-path-publish) is three stacked snapshots of
        the product UI, one per style guide, cross-faded by data-active. Its only
        live controls are the "Apply the ... style guide" cards; every other
        button, tab and select in it is a dead picture of a control (about 60 per
        snapshot, 14px wide), which put them all in the tab order and failed the
        24px touch-target rule. Hidden snapshots are made inert outright; in the
        showing one, every dead control is made inert and the guide cards are
        left alone. Nothing a visitor can do changes: a press on a dead control
        still reaches the frame, so its "use the guide cards" hint still fires.
        Re-applied whenever data-active moves to another snapshot. -->
<style>.rl-sr-only{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}</style>
<script>
(function () {
  var d = document;
  var ICON_NAMES = {
    'icon-arrow-external': 'Open live site',
    'icon-attachment': 'Attach files',
    'icon-mode-light': 'Switch colour theme',
    'icon-mode-dark': 'Switch colour theme'
  };
  var HOSTS = {
    'slack.relume.ai': 'Relume on Slack', 'youtube.com': 'Relume on YouTube',
    'tiktok.com': 'Relume on TikTok', 'instagram.com': 'Relume on Instagram',
    'linkedin.com': 'Relume on LinkedIn', 'x.com': 'Relume on X', 'twitter.com': 'Relume on X'
  };

  function buttons(root) {
    (root || d).querySelectorAll('.p-button[aria-hidden="true"]').forEach(function (b) {
      var link = null;
      for (var i = 0; i < b.children.length; i++) {
        if (b.children[i].matches('a.p-button-link')) { link = b.children[i]; break; }
      }
      b.removeAttribute('aria-hidden');
      var text = b.querySelector('.p-button-text');
      if (!link) {
        /* The control itself. Below 767px its text node is display:none and the
           visible label is CSS ::after content, so name it explicitly. */
        if (text && text.textContent.trim() && !b.getAttribute('aria-label')) b.setAttribute('aria-label', text.textContent.trim());
        return;
      }
      var icon = b.querySelector('.p-icon');
      /* The glyph may already have been redrawn as an SVG, which keeps its name in data-svg-glyph. */
      var glyph = icon && (icon.getAttribute('data-svg-glyph') || icon.textContent.trim());
      var name = (text && text.textContent.trim()) || (glyph && ICON_NAMES[glyph]) || '';
      if (name && !link.getAttribute('aria-label')) link.setAttribute('aria-label', name);
      for (var j = 0; j < b.children.length; j++) {
        if (b.children[j] !== link) b.children[j].setAttribute('aria-hidden', 'true');
      }
      if (b.tagName === 'BUTTON') {
        var div = d.createElement('div');
        for (var k = 0; k < b.attributes.length; k++) div.setAttribute(b.attributes[k].name, b.attributes[k].value);
        while (b.firstChild) div.appendChild(b.firstChild);
        b.parentNode.replaceChild(div, b);
      }
    });
  }

  function textEffects() {
    d.querySelectorAll('[data-anim="text-effect"][aria-label]').forEach(function (el) {
      if (el.getAttribute('role') || /^(A|BUTTON|IMG|INPUT|SELECT|TEXTAREA)$/.test(el.tagName)) return;
      var label = el.getAttribute('aria-label');
      el.removeAttribute('aria-label');
      if (el.querySelector(':scope > .rl-sr-only')) return;
      var s = d.createElement('span');
      s.className = 'rl-sr-only';
      s.textContent = label;
      el.appendChild(s);
    });
  }

  function stickies() {
    d.querySelectorAll('[data-composer-sticky]').forEach(function (el) {
      el.inert = el.getAttribute('aria-hidden') === 'true';
    });
  }

  function tabs() {
    d.querySelectorAll('[role="tab"][aria-controls]').forEach(function (t) {
      var ids = t.getAttribute('aria-controls').split(/\s+/);
      for (var i = 0; i < ids.length; i++) if (ids[i] && d.getElementById(ids[i])) return;
      t.removeAttribute('aria-controls');
    });
  }

  function hovercards() {
    /* Only touch the role when it needs to change: setting an attribute to its
       current value still queues a mutation, which would re-trigger this pass. */
    d.querySelectorAll('a.ra-hc__link').forEach(function (a) {
      var dead = !a.getAttribute('href');
      if (dead && a.getAttribute('role') !== 'none') a.setAttribute('role', 'none');
      else if (!dead && a.getAttribute('role') === 'none') a.removeAttribute('role');
    });
  }

  function shots() {
    var FOCUSABLE = 'button, a[href], input, select, textarea, [tabindex], [role="tab"], [role="button"]';
    d.querySelectorAll('.cpp-frame').forEach(function (frame) {
      var live = frame.getAttribute('data-active') === 'true';
      if (frame.inert === live) frame.inert = !live;
      if (!live) return;
      frame.querySelectorAll(FOCUSABLE).forEach(function (el) {
        if (el.closest('[aria-label^="Apply the "]')) return;
        if (!el.inert) el.inert = true;
      });
    });
  }

  function names() {
    d.querySelectorAll('.fs-cc-banner_close[role="button"]:not([aria-label])').forEach(function (el) {
      el.setAttribute('aria-label', 'Close cookie banner');
    });
    d.querySelectorAll('a.p-navbar_logo-link:not([aria-label]), a.p-footer_logo-link:not([aria-label])').forEach(function (a) {
      if (!a.textContent.trim()) a.setAttribute('aria-label', 'Relume home');
    });
    d.querySelectorAll('a.p-footer_social-link:not([aria-label])').forEach(function (a) {
      if (a.textContent.trim()) return;
      var host = (a.hostname || '').replace(/^www\./, '');
      if (HOSTS[host]) a.setAttribute('aria-label', HOSTS[host]);
    });
  }

  /* Cheap, attribute-level repairs that axe would see mid-render if they waited
     for the debounce; these run on every mutation batch, synchronously. */
  function quick() { tabs(); hovercards(); shots(); }
  function all() { buttons(); names(); textEffects(); stickies(); quick(); }
  all();
  d.addEventListener('DOMContentLoaded', all);
  /* text-effect, the cookie banner, the sticky composer, the hover card, the
     Publish shot and Finsweet-rendered lists all arrive or change after load;
     catch them as they land. */
  var queued = false;
  new MutationObserver(function () {
    quick();
    if (queued) return;
    queued = true;
    setTimeout(function () { queued = false; all(); }, 100);
  }).observe(d.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ['aria-label', 'aria-hidden', 'aria-controls', 'href', 'data-active'] });
})();
</script>
<!-- relume-anim engine + runtime for the below-fold canvases (grow, fc-snake, plan-orbit...). Moved out of the hero cube embed: the hero cubes are pure CSS now, so three.js only loads when the viewport gate releases a canvas.

     PHONES (2026-10-23, perf): below 480px neither script is fetched, so three.js
     never loads. fc-snake is already display:none there (.p-final-cta_snake-layer),
     and any host carrying data-relume-video-light/-dark (grow) plays that
     pre-rendered loop instead, picked by theme, fetched only as it nears the
     viewport. 480px and up is unchanged apart from runtime v15, which parks each
     instance's render loop while it is off screen.

     480px AND UP (2026-10-24): every canvas is below the fold, so the engine and
     runtime now wait for the window load event instead of competing with the
     page's own scripts during load. async=false keeps them executing in order.
     The runtime's own bootAll() on arrival picks up any canvas the viewport gate
     already released, so nothing is missed if someone scrolls before load. -->
<script>
(function () {
  var ENGINE = 'https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6a8d130ccbb9a330c7f7a7c6_relume-engine-v10.js';
  var RUNTIME = 'https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6adb59b992a60e889f51fd36_relume-anim-runtime-v15.js';
  var phone = window.matchMedia && window.matchMedia('(max-width: 479px)').matches;

  if (!phone) {
    var load3d = function () {
      [ENGINE, RUNTIME].forEach(function (src) {
        var s = document.createElement('script');
        s.src = src;
        s.async = false;
        document.head.appendChild(s);
      });
    };
    if (document.readyState === 'complete') load3d();
    else window.addEventListener('load', load3d, { once: true });
    return;
  }

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function dark() { return document.body.classList.contains('p-theme-dark'); }
  function pick(host, v) {
    v.poster = host.getAttribute(dark() ? 'data-relume-poster-dark' : 'data-relume-poster-light') || '';
    if (reduced || !v.dataset.live) return;
    var src = host.getAttribute(dark() ? 'data-relume-video-dark' : 'data-relume-video-light');
    if (src && v.getAttribute('src') !== src) {
      v.setAttribute('src', src);
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  }
  function mount() {
    var hosts = document.querySelectorAll('[data-relume-video-light]');
    if (!hosts.length) return;
    var vids = [];
    Array.prototype.forEach.call(hosts, function (host) {
      var stage = host.querySelector('[data-relume-stage]') || host;
      var v = document.createElement('video');
      v.muted = true; v.loop = true; v.playsInline = true;
      v.setAttribute('muted', ''); v.setAttribute('playsinline', '');
      v.setAttribute('aria-hidden', 'true');
      v.preload = 'none';
      v.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;pointer-events:none';
      stage.appendChild(v);
      vids.push([host, v]);
      pick(host, v);
      if (!window.IntersectionObserver) { v.dataset.live = '1'; pick(host, v); return; }
      new IntersectionObserver(function (entries) {
        var on = entries[entries.length - 1].isIntersecting;
        if (on && !v.dataset.live) { v.dataset.live = '1'; pick(host, v); return; }
        if (!v.getAttribute('src')) return;
        if (on) { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
        else v.pause();
      }, { rootMargin: '300px 0px' }).observe(host);
    });
    /* The theme toggle flips p-theme-dark on <body>; swap to the matching loop. */
    new MutationObserver(function () {
      vids.forEach(function (hv) { pick(hv[0], hv[1]); });
    }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', mount);
  else mount();
})();
</script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a7d042235a99e56e0b16e81%2Fcomposertabscss-1.0.0-1787012941878.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a7d401202468dfb21d397b8%2Fcomposercaretcss-1.0.0-1787021726390.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a83e81c62bfdbeed1ce6aed%2Fcomposerattachcss-1.0.4.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a84f44a1c0ce7a02cfb25ee%2Fcomposerhomecss-1.0.4.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6a87b522e2fcff07575705f6_composer-tabs-fx-v8.js" type="text/javascript" integrity="sha384-j7mRl/taF5npATA4S5cxpJYKzmvrOEl4G304NNUnbBj63zeCm2W+fo0d5/bx0clJ" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a7d37b6db0e6ce239368f07%2Fcomposerinputrules-1.0.0-1786594776185.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a7d209aa134fef826ce4f51%2Fcomposerstickyjs-1.0.0-1787021125530.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a7d56a34dab303a89e9c481%2Fcomposerexampleprompts-1.0.0-1786600915914.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a83e81dd850c8af4313475a%2Fcomposerattachjs-1.0.2.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a83e81dd4a336c739f9c124%2Fcomposerattachfixjs-1.0.2.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a87b5df1248ed240f323059%2Fcomposerhomejs-1.0.1.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c%2F689e5ba67671442434f3ca35%2F6a841bf83f0b12733be15dff%2Fcomposerhometipjs-1.0.0.js" type="text/javascript"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6adb59b9651851a457610dbe_publish-hero-video-v5.js" type="text/javascript" integrity="sha384-+ij2sw/eG9J7LYuuNCiiwOJqHOsq/396k3dadjcEm0SNHWvqcGu+V+voFvik1WwQ" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6a90677bd3184f6c9ec16286_relume-anim-v29.js" type="text/javascript" integrity="sha384-gS9FeIPP4n8jhy73avVUYvmtECaOODJff15xnwksIAUMHxrgH0UTDFQnv6oLw8Fd" crossorigin="anonymous"></script></body></html>