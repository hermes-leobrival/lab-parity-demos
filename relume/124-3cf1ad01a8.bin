<!-- Auth gating before first paint, so header.js can be deferred (perf, 2026-10-23).
     header.js is ~1.1 MB of JS (199 KB gzipped). Loaded synchronously it blocked the
     first paint of every page for seconds on mobile. Its only before-paint job is
     the cached pass hv(qy.member), which writes <style id="rl-not-ms-style"> from
     the member cached in localStorage['rlOurAccountMe'] (when a rl-auth JWT
     exists). This is that pass, ported 1:1: same cache key, same 7-day expiry, same
     hidden tokens. header.js later rewrites the same <style> element, so it still
     owns the gating once it runs. Keep the token logic in step with header.js
     (rules/navbar-auth.md). The avatar initials CSS is left to header.js. -->
<script>
(function () {
  try {
    function ck(n) {
      var m = document.cookie.match('(?:^|; )' + n + '=([^;]*)');
      return m ? decodeURIComponent(m[1]) : '';
    }
    var j = ck('test_jwt') || ck('memberstack_jwt');
    if (!j) { try { j = localStorage.memberstack_jwt_if_cookies_do_not_work || ''; } catch (e) {} }
    var v;
    if (j && j.indexOf('rl-auth-') === 0) {
      try {
        var c = JSON.parse(localStorage.getItem('rlOurAccountMe'));
        if (c && c.value && c.value.accountType !== 'anonymous' && Date.now() - c.timestampMs < 6048e5) v = c.value;
      } catch (e) {}
    }
    var p = (v && v.planName) || 'client';
    var st = v && v.member && v.member.membership && v.member.membership.status;
    var hide = [
      v ? '!members' : 'members',
      st === 'active' ? '!paid' : 'paid',
      st === 'trialing' ? '!trialing' : 'trialing',
      (p === 'client' || p === 'free_2026' || p === 'design') ? '!free-plan' : 'free-plan',
      (p === 'starter' || p === 'design') ? '!starter-plan-monthly' : 'starter-plan-monthly',
      (p === 'creator' || p === 'build') ? '!pro-plan-monthly' : 'pro-plan-monthly'
    ];
    var el = document.createElement('style');
    el.id = 'rl-not-ms-style';
    el.textContent = hide.map(function (t) {
      return '[data-ms-content="' + t + '"] { display: none !important; }';
    }).join('\n');
    document.head.appendChild(el);
  } catch (e) {}
})();
</script>
<!-- ===== After-load loader (perf, 2026-10-24) ================================
     __rlAfterLoad(fn) runs fn once the page has loaded and the main thread is idle
     (2s cap). __rlAfterLoadScript(src) does the same for a script. Used for work
     the first screen does not need: header.js/notifications.js, GA4, PostHog and
     the below-the-fold product shots.

     LATE LISTENERS. A script that arrives after DOMContentLoaded (or after load)
     never hears it - and header.js alone registers 15 DOMContentLoaded listeners.
     So a listener added for an event that has ALREADY fired runs on the next tick
     instead, exactly as if the script had loaded on time. Only document's
     DOMContentLoaded and window's load are affected, and only once they have
     really fired (tracked by the flags below, not by readyState, which turns
     "interactive" before DOMContentLoaded is dispatched). -->
<script>
(function (w, d) {
  var fired = { DOMContentLoaded: false, load: false };
  d.addEventListener('DOMContentLoaded', function () { fired.DOMContentLoaded = true; });
  w.addEventListener('load', function () { fired.load = true; });
  function late(target, type) {
    var add = target.addEventListener;
    target.addEventListener = function (t, fn, opts) {
      if (t === type && fn && fired[type]) {
        var self = this;
        setTimeout(function () {
          var e = new Event(t);
          if (typeof fn === 'function') fn.call(self, e); else fn.handleEvent(e);
        }, 0);
        return;
      }
      return add.call(this, t, fn, opts);
    };
  }
  late(d, 'DOMContentLoaded');
  late(w, 'load');
  var idle = w.requestIdleCallback || function (f) { return setTimeout(f, 1); };
  function afterLoad(fn) {
    function go() { idle(fn, { timeout: 2000 }); }
    if (fired.load) go(); else w.addEventListener('load', go);
  }
  w.__rlAfterLoad = afterLoad;
  w.__rlAfterLoadScript = function (src) {
    afterLoad(function () {
      var s = d.createElement('script');
      s.src = src;
      s.async = true;
      d.head.appendChild(s);
    });
  };
})(window, document);
</script>

<!-- Inlined from three tiny registered scripts that each cost a render-blocking
     request in <head> (perf, 2026-10-24). Same effect, no round trips:
     - CanvasOnlyPlaceholders: hide Designer-only placeholders.
     - IntakeBridgeLoader 1.0.4: the composer's intake styles + /app/intake-bridge.js.
     - RelumeNovaApiBase: ShowcaseCardLikes reads this to reach the LIVE Nova API
       (it otherwise falls back to staging, which 404s every template). -->
<style>[data-canvas-only]{display:none!important}</style>
<style>[data-relume-intake="root"] .p-composer_attachments{display:none}[data-relume-intake-count]:not([data-relume-intake-count="0"]) .p-composer_attachments{display:flex}[data-relume-intake="chips"]{flex-wrap:wrap;overflow:visible}[data-relume-intake="chip"]{flex:0 1 248px;max-width:100%;cursor:default;-webkit-user-select:none;user-select:none}[data-relume-intake="chip-name"]{text-align:left}[data-relume-intake="chip-remove"]{cursor:pointer}[data-relume-intake="chips"][hidden],[data-relume-intake="error"][hidden]{display:none!important}[data-relume-intake="error"]{text-align:left}[data-relume-intake-dragging="true"] .p-composer_form{outline:2px dashed var(--_publish-colors---background--ai-bold,#ff00f4);outline-offset:-2px}[data-relume-intake-state="submitting"] .p-button.is-ai{opacity:.4;pointer-events:none}</style>
<script defer src="/app/intake-bridge.js"></script>
<script>window.__RELUME_NOVA_API = 'https://apis.relume.io';</script>

<!-- header.js + notifications.js now load after the page (perf, 2026-10-24).
     The inline auth pass above already gates the navbar before first paint; the
     rest of header.js (avatar initials, logout, __relumeMemberReady, the
     $memberstackDom shim) fills in about a second later. async=false keeps the two
     in their original order. -->
<link rel="preconnect" href="https://d3ixo2kr99szog.cloudfront.net" crossorigin>
<script>
window.__rlAfterLoad(function () {
  ['https://d3ixo2kr99szog.cloudfront.net/header.js?v=2',
   'https://d3ixo2kr99szog.cloudfront.net/notifications.js?v=2'].forEach(function (src) {
    var s = document.createElement('script');
    s.src = src;
    s.async = false;
    document.head.appendChild(s);
  });
});
</script>
<!-- pricing-embed.js (~265 KB, built from nova frontend/pricing_embed) is a no-op on
     any page without a pricing mount, but was fetched and parsed on every page.
     Now: no mount, no download. With a mount (the homepage's pricing section), it
     loads as that section comes within 1500px of the viewport, or 1.5s after the
     load event, whichever is first - off the critical path, but in place well before
     anyone scrolls to it. Pricing pages carry their own direct <script> tag too,
     and the embed guards against mounting twice. Same URL, so the contract in
     docs/webflow-pricing-script.md still holds. -->
<script>
(function (w, d) {
  var SRC = '/app/_account/pricing-embed.js', done = false;
  function load() {
    if (done) return;
    done = true;
    var s = d.createElement('script');
    s.src = SRC;
    s.async = true;
    d.head.appendChild(s);
  }
  d.addEventListener('DOMContentLoaded', function () {
    var mount = d.querySelector('#newPricing, [data-relume-pricing="root"]');
    if (!mount) return;
    if (!w.IntersectionObserver) { load(); return; }
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) { io.disconnect(); load(); return; }
      }
    }, { rootMargin: '1500px 0px' });
    io.observe(mount);
    w.addEventListener('load', function () { setTimeout(load, 1500); });
  });
})(window, document);
</script>
<!-- End Critical Scripts -->


<!-- ===== Theme boot (SITE LEVEL) ==============================================
     Applies the colour mode before first paint, on every page. Without it a
     stored choice was forgotten on navigation - toggle to dark on /publish, land
     on /pricing in light - because only four pages booted a theme of their own.

     DEFAULT IS LIGHT (3 Sept 2026, was SYSTEM). The OS preference is not
     consulted: a visitor on a dark desktop lands on the light site and stays
     there. Only an explicit toggle click writes localStorage['relume-color-mode'],
     and a stored choice still wins - that is what the toggle is for.

     Four scripts used to carry a system fallback and all four now default to
     light: this one, the inline data-theme-boot in Publish Global Styles,
     RelumeAnimBoot (1.2.1 / 1.5.1) and RelumeThemeBoot (1.1.0). They must agree;
     this one runs first and would otherwise win. See rules/theme.md.

     Keep it above the analytics and third-party loaders below - a theme applied
     after them still risks a flash.

     NOTE on p-body: the dark palette is .p-body.p-theme-dark, but the
     data-ensure-p-body shim in Publish Global Styles adds that class at runtime
     on every page carrying the component (40 of 57), which is why pages with a
     bare <body> in the markup still theme correctly. Pages outside that set are
     utility pages that are not themed. -->
<script>
(function () {
  try {
    var K = 'relume-color-mode', d = document.documentElement, m = null;
    try { m = localStorage.getItem(K); } catch (e) {}
    if (m !== 'dark' && m !== 'light') { m = 'light'; }
    d.setAttribute('data-theme', m);
    if (m !== 'dark') return;
    var add = function () {
      if (!document.body) return false;
      document.body.classList.add('p-theme-dark');
      return true;
    };
    if (add()) return;
    /* <body> does not exist yet in <head>, so wait for it rather than for
       DOMContentLoaded - the class must land before the body paints. */
    var o = new MutationObserver(function () { if (add()) o.disconnect(); });
    o.observe(d, { childList: true, subtree: true });
    document.addEventListener('DOMContentLoaded', function () { add(); o.disconnect(); });
  } catch (e) {}
})();
</script>
<!-- ===== Deferred third-party loader (perf, 2026-10-23) =====================
     Ad pixels and affiliate tags are not needed to render or use the page, but
     on a phone they cost ~0.5 s of main thread during load. __rlDelay(src, attrs)
     queues a script until the visitor first interacts (scroll, tap, key, mouse)
     or 5 s after the load event, whichever comes first. Every tag keeps its
     queueing stub (fbq, lintrk, rewardful, gtag), so calls made before the
     script arrives are replayed by it, exactly as with an async load.
     GA4 (G-4F5ELX0KXH), PostHog and the consent banner are NOT delayed. -->
<script>
(function (w, d) {
  var q = [], fired = false, EV = ['pointerdown', 'keydown', 'touchstart', 'scroll', 'mousemove', 'wheel'];
  function inject(src, attrs) {
    var s = d.createElement('script');
    s.async = true;
    s.src = src;
    if (attrs) for (var k in attrs) s.setAttribute(k, attrs[k]);
    d.head.appendChild(s);
  }
  function fire() {
    if (fired) return;
    fired = true;
    EV.forEach(function (e) { w.removeEventListener(e, fire, { passive: true }); });
    var list = q; q = null;
    list.forEach(function (x) { inject(x[0], x[1]); });
  }
  EV.forEach(function (e) { w.addEventListener(e, fire, { passive: true }); });
  w.addEventListener('load', function () { setTimeout(fire, 5000); });
  w.__rlDelay = function (src, attrs) { if (fired) inject(src, attrs); else q.push([src, attrs]); };
})(window, document);
</script>

