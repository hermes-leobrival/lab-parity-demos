/* Element you wish to animate */
.logo3_list {
  -webkit-animation: logoloop 30s linear infinite;
  -moz-animation: logoloop 30s linear infinite;
  -o-animation: logoloop 30s linear infinite;
}

/* When hover or focus-within on animated elements parent, pause the animation */
.logo3_component:hover .logo3_list,
.logo3_component:focus-within .logo3_list {
  -webkit-animation-play-state: paused;
  -moz-animation-play-state: paused;
  -o-animation-play-state: paused;
  animation-play-state: paused;
}

/* If user has prefers reduced motion on in OS, pause the animation */
@media (prefers-reduced-motion) {
  .logo3_component .logo3_list {
    -webkit-animation-play-state: paused;
    -moz-animation-play-state: paused;
    -o-animation-play-state: paused;
    animation-play-state: paused;
  }
}

/* Keyframes of animation to run with prefixing for full browser support */
@keyframes logoloop {
  0% {
    transform: translateX( calc(0% + 50px));
  }
  100% {
    transform: translateX(-100%);
  }
}
</style></div><div><div class="w-embed"><style>
  body.p-theme-dark .logo3_wrapper {
    filter: invert(1);
  }
</style></div><div class="w-embed w-script"><!-- data-wf-mode: currently INERT. It writes its own preference under the
     localStorage key 'theme' (not 'relume-color-mode') and stamps data-wf-mode
     on <body>, but data-wf-mode appears ZERO times in the compiled stylesheet -
     nothing is styled by it. Looks like scaffolding for a Webflow-native
     variable-mode migration that never landed.

     Kept rather than deleted (28 Aug 2026 decision) pending a wider theme
     cleanup, but its default is aligned with the rest of the system: LIGHT, not
     the OS preference. If it is ever wired up for real, it must not disagree
     with the boots. See rules/theme.md. -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const btn = document.getElementById('p-mode-toggle');
  const root = document.body;

  const lightModeName = 'Light';
  const darkModeName = 'Dark';

  /* Light unless the visitor has explicitly chosen otherwise. The OS
     preference is deliberately not consulted. */
  const saved = localStorage.getItem('theme');
  const initialMode = saved || lightModeName;

  root.setAttribute('data-wf-mode', initialMode);

  btn?.addEventListener('click', () => {
    const current = root.getAttribute('data-wf-mode');
    const next = current === darkModeName ? lightModeName : darkModeName;

    root.setAttribute('data-wf-mode', next);
    localStorage.setItem('theme', next);
  });
});
</script></div></div></div><div class="w-embed"><!-- Pixel edge follows the cards' white hover.

     .p-pixel-block is hardwired to Background/primary, the cards' resting
     colour, so on hover the pixel seam stayed off-white against a white card.
     Applied to the engine cards too, which had the same mismatch.

     This lives in the component rather than the site script list on purpose. It
     shipped as the PixelBlockHover site script first and was silently dropped on
     2026-08-18 when an unrelated composer update called set_site_scripts, which
     replaces the applied list rather than adding to it. Nothing in that API can
     remove this embed. The script is still applied as a duplicate for any page
     that does not carry this component; both carry data-pixel-block-hover and
     the script no-ops when this one is already present.

     The transition sits inside the :hover rule deliberately. On the base rule it
     would also cover theme switches, and Chrome does not re-run a transition
     when only the custom property behind the value changes - the blocks would
     hold their old colour until reload. Here the hover fades and a theme switch
     still repaints instantly. -->
<style data-pixel-block-hover>
  .choose-path_component:hover .p-pixel-block:not(.is-transparent),
  .icon-tagline_card:hover .p-pixel-block:not(.is-transparent) {
    background-color: var(--_publish-colors---background--secondary);
    transition: background-color 200ms ease;
  }
</style></div><div class="w-embed w-script"><!-- Dark mode is .p-body.p-theme-dark on <body>, and the light palette that the
     dark rule overrides is declared on .p-body. A page whose <body> carries no
     class therefore reads the :root light values and can never go dark - the
     toggle in the navbar appears to do nothing.

     The Body element's class cannot be set through the Webflow Data API: Body
     reports "This element doesn't support styles" and exposes only domId. So
     this component - which already means "this is a Publish page" - ensures it.

     Idempotent: on the pages that already have the class in the Designer this is
     a no-op. The clean permanent fix is to add the p-body class to Body in the
     Designer, which also removes the brief light flash before this runs; this
     embed can then be deleted. Same rationale as the pixel-block embed above:
     kept in the component rather than the site script list. -->
<script data-ensure-p-body>
  (function () {
    var b = document.body;
    if (b && !b.classList.contains('p-body')) b.classList.add('p-body');
  })();
</script>

<!-- Theme boot. Applies the colour mode before the page paints, on every page
     carrying this component - so the theme behaves identically everywhere
     instead of only where RelumeAnimBoot happens to be wired.

     DEFAULT IS LIGHT (28 Aug 2026, was SYSTEM). The OS preference is not
     consulted at all: a visitor on a dark desktop lands on the light site and
     stays there. Only an explicit toggle click writes
     localStorage['relume-color-mode'], and a stored choice still wins - that is
     what the toggle is for.

     The live prefers-color-scheme listener that used to sit at the bottom of
     this script is gone with it. The OS flipping to dark must not move a
     visitor who never asked for it.

     Runs immediately rather than on DOMContentLoaded: this component sits at the
     very top of the page wrapper, before anything has painted, so applying the
     class here avoids a dark flash for visitors who stored dark.

     Deliberately does NOT load relume-anim-v25.css - the footer component's
     fx loader already does that (guarded on href), and the wipe transition only
     needs it before the first click, not before first paint.

     Idempotent and safe to run alongside the site-head boot and RelumeAnimBoot,
     which do the same thing; all three must agree on the default. Pairs with the
     site-footer toggle script (writes the key) and the fx engine's initTheme
     (the View Transition wipe that reads the body class). See rules/theme.md. -->
<script data-theme-boot>
(function () {
  var KEY = 'relume-color-mode', d = document.documentElement, obs = null;

  function stored() {
    try {
      var v = localStorage.getItem(KEY);
      return (v === 'dark' || v === 'light') ? v : null;
    } catch (e) { return null; }
  }

  function apply(mode) {
    var dark = mode === 'dark';
    d.setAttribute('data-theme', mode);

    function cls() {
      if (!document.body) return false;
      document.body.classList.toggle('p-theme-dark', dark);
      return true;
    }

    /* <body> normally exists by the time this runs, but guard anyway: if the
       embed is ever moved higher, fall back to watching for it. */
    if (!cls() && !obs) {
      obs = new MutationObserver(function () {
        if (cls()) { obs.disconnect(); obs = null; }
      });
      obs.observe(d, { childList: true, subtree: true });
      document.addEventListener('DOMContentLoaded', function () {
        cls();
        if (obs) { obs.disconnect(); obs = null; }
      });
    }
  }

  apply(stored() || 'light');
})();
</script></div><div class="w-embed"><style data-links-never-buttons>
/* A link is never a button. CMS authors paste <button class="w-button
   button-secondary"> inside an <a> in rich text, which renders body copy links
   as bordered buttons. Scoped to .text-rich-text so real .p-button elements and
   the nav/CTA buttons are untouched.

   The <a> itself already themes correctly (measured: #343434 light ->
   #8a8a8a dark). The <button> did not: it stayed #343434 in both, and its
   -webkit-text-fill-color computed to the same value. text-fill-color paints
   the glyphs regardless of `color`, so setting `color` alone can never fix it.
   The button now inherits the anchor's colour and text-fill is released back to
   currentColor, so it follows the theme and the hover. */
.text-rich-text a .w-button,
.text-rich-text a button,
.text-rich-text .w-embed a button{
  display:inline;height:auto;min-height:0;padding:0;margin:0;
  border:none;border-radius:0;background:none;
  font:inherit;line-height:inherit;
  color:inherit!important;
  -webkit-text-fill-color:currentColor!important;
  text-decoration:underline;text-decoration-style:dotted;
  text-decoration-color:var(--_publish-colors---foreground--accent);
  text-decoration-thickness:12%;text-underline-offset:3px;text-decoration-skip-ink:none;
  transition:color 200ms ease;
}
.text-rich-text a{
  color:var(--_publish-colors---foreground--secondary)!important;
  -webkit-text-fill-color:currentColor!important;
  transition:color 200ms ease;
}
.text-rich-text a:hover{
  color:var(--_publish-colors---foreground--primary)!important;
}
</style></div><div class="w-embed w-script"><style data-wn-asset-theme>
/* Composited post assets are ARTWORK, not UI. They sit on a fixed background
   image, so their text must not follow light/dark mode - bound to
   --_publish-colors---foreground--primary they turned white in dark mode and
   became unreadable over a light photo.

   Colour and lockup are both chosen per post in the CMS and stay put. Option
   fields cannot bind to an attribute (set_settings rejects it the same way it
   rejects booleans), so each value is bound into a hidden marker -
   .wn-asset_theme and .wn-asset_logoname - and read by the script below. */
.wn-asset_title,
.wn-asset_desc{color:#101010}
.wn-asset_overlay[data-asset-text="light"] .wn-asset_title,
.wn-asset_overlay[data-asset-text="light"] .wn-asset_desc{color:#ffffff}

/* ---- type scale (Figma 10736:225766) ----
   The artboard is 1200x630 for Cover (feed card AND nav dropdown) and 2420x630
   for Header. Both carry the SAME absolute composition - logo 48, heading 82/1,
   sub-line 30.583/1.4, 12.233 between each, 73.398 of side padding - so only
   the canvas width differs.

   Everything is a share of the asset's width in cqw, not px. These are assets:
   the composition has to scale with the box, or an 82px heading designed against
   1200 renders half the artboard wide on a 300px dropdown thumbnail. One set of
   numbers is then correct at every size, and the per-breakpoint overrides this
   used to need are gone.

   THE CONTAINER IS THE ASSET BOX, NOT THE OVERLAY. An element cannot query
   itself: with container-type on the overlay, the overlay's own padding and
   row-gap escaped to the nearest ancestor container - the viewport - and came
   out at 88px instead of 52, shrinking the whole composition to 79%. */
.wn-nav-asset,
.wn-header-asset,
.section-whatsnew-feed .whatsnew-feed_image-wrapper{container-type:inline-size}

.wn-asset_overlay{
  padding-left:6.1165cqw;padding-right:6.1165cqw;   /* 73.398 / 1200 */
  row-gap:1.0194cqw;                                /* 12.233 / 1200 */
}
.wn-asset_title{
  font-size:6.8333cqw;                              /* 82 / 1200 */
  line-height:1;letter-spacing:-0.05em;             /* -4.1 at 82px */
  font-variation-settings:"wght" 440;
  max-width:63.7136cqw;                             /* 764.563 / 1200 */
  /* max height is two lines, per the design - clamped rather than cut so a long
     title ellipsises instead of spilling over the artwork */
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.wn-asset_desc{
  font-size:2.5486cqw;                              /* 30.583 / 1200 */
  line-height:1.4;letter-spacing:-0.01em;           /* -0.3058 at 30.583px */
  font-variation-settings:"wght" 440;
}

/* The lockup ships as TWO real SVGs per brand, one with a dark wordmark and one
   with a light one, rather than a single dark file inverted by a filter. The
   old brightness(0) invert(1) was fine for the monochrome Relume mark but would
   flatten the coloured Publish, Export and MCP icons to solid white. Only the
   wordmark differs between the two files; the icon keeps its brand colour.

   Sized by HEIGHT, never width: the four lockups are 109 to 167 wide at the
   same 32 tall, so a fixed width would render MCP two-thirds too small. */
.wn-asset_logo{width:auto;margin:0}
.wn-asset_logo img{display:block;height:4cqw;width:auto;max-width:100%}  /* 48 / 1200 */

/* ---- Header artboard is 2420 wide, so the same absolute sizes are a smaller
   share of it. Only the divisor changes. ---- */
.wn-header-asset .wn-asset_overlay{
  padding-left:3.0330cqw;padding-right:3.0330cqw;   /* 73.398 / 2420 */
  row-gap:0.5055cqw;                                /* 12.233 / 2420 */
}
.wn-header-asset .wn-asset_title{
  font-size:3.3884cqw;                              /* 82 / 2420 */
  max-width:31.5936cqw;                             /* 764.563 / 2420 */
}
.wn-header-asset .wn-asset_desc{font-size:1.2638cqw}  /* 30.583 / 2420 */
.wn-header-asset .wn-asset_logo img{height:1.9835cqw} /* 48 / 2420 */
</style>
<script data-wn-asset-theme>
(function(){
  var BASE='https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/';
  var LOGOS={
    relume:['6a866e7502a01b7f0b8745bf_wn-logo-relume-dark.svg','6a866e7691bca96735852ffd_wn-logo-relume-light.svg'],
    publish:['6a866e76897b488119f9dfce_wn-logo-publish-dark.svg','6a866e7724482b3af30d6937_wn-logo-publish-light.svg'],
    export:['6a866e7820919d81f8bfac9c_wn-logo-export-dark.svg','6a866e782cac5e3156c5c073_wn-logo-export-light.svg'],
    mcp:['6acf99c9f56dbb3f5b08c405_logo-relume-mcp-dark.svg','6acf99c78fd4e41e66a23106_logo-relume-mcp-light.svg'],
    studio:['6ae91b09c5630a9de1976752_wn-logo-studio-dark.svg','6ae91b0a921e869118b4d596_wn-logo-studio-light.svg']
  };
  /* "No logo" -> "nologo", which is deliberately absent from LOGOS, so it and an
     empty value (every older post) both mean no lockup. */
  function key(el){ return ((el&&el.textContent)||'').trim().toLowerCase().replace(/[^a-z]/g,''); }
  function apply(){
    document.querySelectorAll('.wn-asset_overlay').forEach(function(o){
      var light=key(o.querySelector('.wn-asset_theme'))==='light';
      o.setAttribute('data-asset-text', light?'light':'dark');

      var pair=LOGOS[key(o.querySelector('.wn-asset_logoname'))];
      var box=o.querySelector('.wn-asset_logo');
      if(!pair){ if(box&&box.parentNode) box.parentNode.removeChild(box); return; }
      /* Built here rather than authored: a Webflow element whose visibility is
         bound to a CMS field is REMOVED from the DOM when false, so an authored
         logo could never be switched back on per item. */
      if(!box){
        box=document.createElement('div');
        box.className='wn-asset_logo';
        o.insertBefore(box,o.firstChild);
      }
      var img=box.querySelector('img');
      if(!img){ img=document.createElement('img'); img.alt=''; box.replaceChildren(img); }
      img.src=BASE+pair[light?1:0];
    });
  }
  /* The navbar dropdown builds its card after this has already run, so it calls
     back in rather than keeping a second copy of the logo table. */
  window.wnAssetApply=apply;
  if(document.readyState!=='loading') apply();
  else document.addEventListener('DOMContentLoaded',apply);
})();
</script></div><div class="w-embed w-script">
<!-- ===== Icon glyphs that fail on iOS Safari (v2) ================================
     Authored by a parallel session (relume-0d), reviewed and applied here.
     v1 2026-08-20, v2 same day.

     These icons are font LIGATURES: .p-icon holds the literal text "icon-system"
     and the font's liga feature swaps in a glyph. iOS Safari does not apply that
     substitution, so the raw string renders and the 16px wrapper clips it - the
     tile looks empty on iPhone while Chrome is fine. Measured in WebKit: range
     width 96px at font-size 16 (text) vs 16px in Chrome (glyph). Paths are lifted
     from the site's own fonts, not redrawn; currentColor + 1em inherit colour and
     size exactly as the glyph did; scale(1 -1) converts font y-up to SVG y-down.

     FOOTER, not head: DOM-modifying and DOMContentLoaded-gated, per
     rules/custom-code-placement.md. Not a registered script because the site is
     at Webflow's hard cap of 15 applied site scripts and register_inline_script
     caps at 2000 chars.

     v2 fixes two defects found in v1 on production:
     1. SOMETHING REWRITES .p-icon textContent AFTER we run, so icon-system came
        back as text with our data-svg-glyph flag still set - v1 treated it as done
        and it stayed blank, the very icon being fixed. "Done" now means our <svg>
        is still present, and a MutationObserver re-applies if the text is put back.
        It cannot loop: re-inserting the svg makes the element done again.
     2. The paint assertion tested svg.offsetParent, which is undefined on
        SVGElement, so the guard never skipped and it warned about legitimately
        display:none icons. It now tests the parent element.

     WHO DOES THE REWRITING (traced 2026-08-20 by hooking the textContent setter):
     a PAGE-LEVEL embed on /publish-dev/export and /publish-dev/new-homepage-publish
     that scopes Relume-Icons-Ext by content and also assigns icons by card heading -
     `BY_HEADING = [[/^Assembled, not generated/, "icon-system"], ...]` with
     `el.textContent = t = BY_HEADING[j][1]`. Its apply() runs on DOMContentLoaded
     AND load, unconditionally. The durable fix is to make that script skip elements
     carrying [data-svg-glyph]; the observer here is the safety net, not the cure.
     If that guard is added, this observer can be narrowed or dropped.

     RELATED TRAP, same root cause as an invisible menu button shipped earlier today:
     a glyph sized above its 16px .p-icon-wrapper wraps out of view and paints
     nothing while every computed style still looks correct. Hence overflow:visible
     and white-space:nowrap below, and hence an assertion that measures the box
     rather than trusting computed styles.
     ========================================================================= -->
<style>
  .p-icon[data-svg-glyph] { display: inline-flex; align-items: center; justify-content: center; overflow: visible; white-space: nowrap; }
  .p-icon[data-svg-glyph] > svg { width: 1em; height: 1em; flex: none; display: block; overflow: visible; }
</style>
<script>
(function () {
  var G = {"icon-system":{"vb":"-0.3 -893.6 890.6 890.6","d":"M334 800H71Q0 799 0 728V230Q0 159 71 159H323L293 83H258Q218 83 218 43Q218 3 258 3H320Q323 3 322 3H568Q567 3 569 3H632Q672 3 672 43Q672 83 632 83H597L567 159H819Q890 159 890 230V408Q890 449 850 449Q809 449 809 408V239H80V719H334Q375 719 375 759Q375 800 334 800ZM380 83 410 159H480L510 83ZM648 890 643 888 456 779Q436 767 436 744V557Q436 534 456 522L643 413Q663 401 683 413L870 522Q890 534 890 557V744Q890 767 870 779L683 888Q666 898 648 890ZM516 721 663 806 809 721V580L663 495L516 580ZM663 722Q633 722 612 701Q592 680 592 650Q592 621 612 600Q633 579 663 579Q693 579 713 600Q734 621 734 650Q734 680 713 701Q692 722 663 722ZM663 659Q667 659 669 657L671 654Q672 652 672 650Q672 646 669 644L666 642Q665 641 663 641Q659 641 656 644Q654 647 654 650Q654 654 656 657Q659 659 663 659Z"},"icon-edit":{"vb":"-0.0 -893.0 890.1 890.1","d":"M808 492Q808 488 807 484Q805 480 802 477L427 99L304 89L314 212L692 587Q695 590 699 592Q703 594 707 594Q712 594 716 592Q720 590 723 587L802 508V507Q805 504 807 500Q808 496 808 492ZM890 492Q890 513 882 532Q876 546 866 558L860 565L781 644Q767 659 747 667Q728 675 707 675Q692 675 677 671L667 667Q649 659 634 645L246 259Q238 252 235 241L234 234L218 47Q216 28 230 15Q243 2 262 3L449 19Q464 21 474 31L860 419Q874 434 882 453Q890 472 890 492ZM230 752 235 764 240 752Q266 689 330 663L341 658L330 653Q266 627 240 563L235 552L230 563Q204 627 141 653L129 658L141 663Q204 689 230 752ZM470 658Q470 688 445 703L438 706L361 738Q329 751 315 784L284 861L280 868Q267 889 243 892L235 893Q205 893 190 868L187 861L155 784Q142 751 109 738L32 706Q5 695 1 666L0 658L1 650Q5 621 32 609L109 578Q142 564 155 532L187 455L190 448Q205 423 235 423Q270 423 284 455L315 532Q329 564 361 578L438 609Q470 623 470 658Z"},"icon-graph-increase":{"vb":"0.0 -893.0 890.0 890.0","d":"M645 377 649 375 653 374 657 373H661H665L670 374L674 375L678 376L681 378L685 380L689 382L692 385L695 388L697 391L700 394L884 699L886 703L887 707L889 711V715L890 719V724V728L889 732L887 736L886 740L884 744L881 748L879 751L876 754L872 757L869 759L865 761L861 763L857 764L853 765L848 766H844L840 765L836 764L831 763L827 761L824 759L820 757L817 754L814 751L811 748L809 744L644 472L394 578L390 580L386 581H381L377 582L373 581H369L365 580L361 579L357 577L353 575L350 573L347 570L344 567L341 563L146 293L143 290L141 286L140 282L138 278V273L137 269V265L138 261L139 256L140 252L142 248L144 245L146 241L149 238L152 235L155 232L159 230L163 228L167 226L171 225L175 224H179H184H188L192 225L196 226L200 228L204 230L208 233L211 235L214 238L217 242L392 484ZM0 43 1 38 2 34 3 30 5 26 7 23 10 19 13 16 16 13 19 10 23 8 27 6 31 5 35 4 40 3H44H846H850L855 4L859 5L863 6L867 8L870 10L874 13L877 16L880 19L883 23L885 26L887 30L888 34L889 38L890 43V47V51L889 55L888 60L887 64L885 68L883 71L880 75L877 78L874 81L870 83L867 86L863 87L859 89L855 90L850 91H846H88V849V853L87 858L86 862L84 866L83 870L80 873L78 877L75 880L72 883L68 886L65 888L61 890L57 891L52 892L48 893H44H40L35 892L31 891L27 890L23 888L19 886L16 883L13 880L10 877L7 873L5 870L3 866L2 862L1 858L0 853V849V47Z"},"icon-arrow-external":{"vb":"67.2 -893.0 889.8 889.8","d":"M957 181V849C957 873 937 893 913 893H245C220 893 201 873 201 849C201 825 220 805 245 805H807L80 78C63 61 63 33 80 16C97 -1 125 -1 142 16L869 743V181C869 156 889 137 913 137C937 137 957 156 957 181Z"}};

  var NS = 'http://www.w3.org/2000/svg';

  function done(el) {
    // Only "done" if our svg is still in there. The attribute alone is not enough:
    // another script can reset textContent and wipe the svg while the flag stays.
    var svg = el.firstElementChild;
    return !!svg && svg.namespaceURI === NS && el.getAttribute('data-svg-glyph');
  }

  function swap(el) {
    var name = (el.getAttribute('data-svg-glyph') || el.textContent || '').trim();
    var g = G[name];
    if (!g || done(el)) return;
    el.setAttribute('data-svg-glyph', name);
    el.textContent = '';
    var svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('viewBox', g.vb);
    svg.setAttribute('fill', 'currentColor');
    svg.setAttribute('aria-hidden', 'true');
    svg.setAttribute('focusable', 'false');
    var gEl = document.createElementNS(NS, 'g');
    gEl.setAttribute('transform', 'scale(1 -1)');
    var p = document.createElementNS(NS, 'path');
    p.setAttribute('d', g.d);
    gEl.appendChild(p); svg.appendChild(gEl); el.appendChild(svg);
  }

  function run() {
    document.querySelectorAll('.p-icon').forEach(swap);
    // Assert it actually painted - computed styles can all look right while the
    // glyph is clipped to nothing. Test the PARENT for visibility: an <svg> has no
    // offsetParent, so testing the svg would never skip hidden icons.
    document.querySelectorAll('.p-icon[data-svg-glyph]').forEach(function (el) {
      if (el.offsetParent === null) return;
      var svg = el.firstElementChild;
      var r = svg && svg.getBoundingClientRect();
      if (!r || !r.width || !r.height) {
        console.warn('[icon-fix] not painting:', el.getAttribute('data-svg-glyph'),
          r ? r.width + 'x' + r.height : 'no svg');
      }
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', run);
  else run();
  window.addEventListener('load', run);

  // Re-apply if anything rewrites an icon's text later. Terminates: our own
  // insertion leaves the element "done", so the next callback skips it.
  if (window.MutationObserver) {
    new MutationObserver(function (muts) {
      for (var i = 0; i < muts.length; i++) {
        var t = muts[i].target;
        var el = t.nodeType === 1 ? t : t.parentNode;
        if (!el || el.nodeType !== 1) continue;
        if (el.classList && el.classList.contains('p-icon')) swap(el);
        else if (el.querySelectorAll) el.querySelectorAll('.p-icon').forEach(swap);
      }
    }).observe(document.documentElement, { childList: true, subtree: true, characterData: true });
  }
})();
