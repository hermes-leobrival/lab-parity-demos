(function () {
  var KEY = 'relume-color-mode', CLS = 'p-theme-dark', body = document.body;
  function label(isDark) {
    var i = document.querySelector('#p-mode-toggle .p-icon');
    if (i) i.textContent = isDark ? 'icon-mode-dark' : 'icon-mode-light';
  }
  function set(mode) {
    var isDark = mode === 'dark';
    body.classList.toggle(CLS, isDark);
    document.documentElement.setAttribute('data-theme', mode);
    label(isDark);
    try { localStorage.setItem(KEY, mode); } catch (e) {}
  }
  function init() {
    label(body.classList.contains(CLS));
    var t = document.getElementById('p-mode-toggle') || document.querySelector('.mode-switch_wrapper');
    if (!t) return;
    t.addEventListener('click', function (e) {
      e.preventDefault();
      set(body.classList.contains(CLS) ? 'light' : 'dark');
    });
  }
  document.readyState === 'loading'
    ? document.addEventListener('DOMContentLoaded', init)
    : init();
})();
</script>
