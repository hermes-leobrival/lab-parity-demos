9c/630e8a89d2ae29fb1ffe51d6_Headspace%20logo-p-500.png 500w, https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/630e8a89d2ae29fb1ffe51d6_Headspace%20logo.png 560w"/></div><div id="w-node-d943af8e-973d-628c-9433-94c92935bd77-146b7924" class="logo3_wrapper"><img decoding="async" loading="lazy" alt="" src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6834408088c28dc208525adb_dept-logo.png" class="logo3_logo"/></div><div id="w-node-d943af8e-973d-628c-9433-94c92935bd79-146b7924" class="logo3_wrapper"><img decoding="async" loading="lazy" alt="" src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6834408058f0ebe311f81f31_darktrace-logo.png" class="logo3_logo"/></div><div id="w-node-d943af8e-973d-628c-9433-94c92935bd7b-146b7924" class="logo3_wrapper"><img decoding="async" loading="lazy" alt="" src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6834407fd353192b1b9fedae_rokt-logo.png" class="logo3_logo"/></div><div id="w-node-d943af8e-973d-628c-9433-94c92935bd7d-146b7924" class="logo3_wrapper"><img decoding="async" loading="lazy" alt="" src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6834407fe5c8a77fdfc6e5e4_ideo-logo.png" class="logo3_logo"/></div><div id="w-node-d943af8e-973d-628c-9433-94c92935bd7f-146b7924" class="logo3_wrapper"><img decoding="async" loading="lazy" alt="" src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/66be75a0f3dfe74a939413fa_nike-logo.png" class="logo3_logo"/></div></div><div class="logo_endcap is-left"></div><div class="logo_endcap is-right"></div></div></div></div></div></div></section><div class="p-section_choose-path"><div class="p-padding-global"><div class="container-large"><div class="padding-section-medium"><div data-wf--section-header--variant="base" class="p-section-header"><div class="p-section-header_left-content"><div class="p-section-header_tagline-wrapper"><div data-wf--tagline--variant="accent" class="p-tagline"><div class="p-tagline-large">あなたに合った道を選ぶ</div></div></div><div class="p-section-header_title"><h2 class="p-heading-style-h3">Relumeで公開するか、使い慣れたツールへエクスポート。</h2></div></div><div class="p-section-header_right-content"><p class="p-section-header_text">すべては同じコンポーネントシステムから始まります。クライアントサイトをRelumeでホストしてワンクリックで公開するか、MCPを使ってFigma、Webflow、Reactへ持ち出すか。システムは同じ、選ぶのはあなたです。</p></div></div><div class="margin-bottom margin-medium"><div class="choose-path_component"><div class="w-layout-grid choose-path_content"><div id="w-node-d943af8e-973d-628c-9433-94c92935bd8e-146b7924" class="choose-path_content-right"><div class="choose-path_content-wrapper"><div class="choose-path_tagline-wrapper"><div class="p-icon-wrapper is-large"><img src="https://cdn.prod.website-files.com/6177739448baa66404ce1d9c/6a7401941b4036fddb02f964_icon-logo-publish.svg" loading="lazy" decoding="async" alt=""/></div><div data-wf--tagline--variant="accent" class="p-tagline"><div class="p-tagline-large">Publish</div></div></div><h2 class="p-heading-style-h4">Relumeでサイトを公開し、そのまま成長させ続ける</h2><p class="p-text-size-xlarge p-text-color-secondary">ブリーフから公開まで一つの流れで完結。カスタムドメインとSSLも自動で設定されます。公開後も、システムが成果の出る要素を学習し、サイトは改善され続けます。</p><div class="p-button-group"><div STYLE="" aria-hidden="true" id="" class="p-button is-ai"><div class="p-button-text">無料で始める</div><a href="/app/signup" class="p-button-link w-inline-block"></a></div><div STYLE="" aria-hidden="true" id="" class="p-button is-secondary"><div class="p-button-text">Publishを見る</div><a href="/ja/publish" class="p-button-link w-inline-block"></a></div></div></div><div class="w-layout-grid choose-path_item-list"><div id="w-node-_35247e90-1d65-f53e-401f-26d24dca70df-4dca70df" class="choose-path_item"><div class="choose-path_item-icon-wrapper"><div data-wf--icon-wrapper--icon-size="small" class="p-icon-wrapper"><div class="p-icon">icon-globe-synced</div></div></div><div class="choose-path_item-text-wrapper"><h3 class="p-text-size-large p-text-weight-medium is-cp-feature-title">グローバルエッジネットワーク</h3><p class="p-text-size-medium p-text-color-tertiary is-cp-feature-text">Sub-second load times anywhere, on a global CDN</p></div></div><div id="w-node-_35247e90-1d65-f53e-401f-26d24dca70df-4dca70df" class="choose-path_item"><div class="choose-path_item-icon-wrapper"><div data-wf--icon-wrapper--icon-size="small" class="p-icon-wrapper"><div class="p-icon">icon-lock</div></div></div><div class="choose-path_item-text-wrapper"><h3 class="p-text-size-large p-text-weight-medium is-cp-feature-title">エンタープライズ級のセキュリティ</h3><p class="p-text-size-medium p-text-color-tertiary is-cp-feature-text">SSL、DDoS対策、SOC 2準拠（申請中）</p></div></div><div id="w-node-_35247e90-1d65-f53e-401f-26d24dca70df-4dca70df" class="choose-path_item"><div class="choose-path_item-icon-wrapper"><div data-wf--icon-wrapper--icon-size="small" class="p-icon-wrapper"><div class="p-icon">icon-improve</div></div></div><div class="choose-path_item-text-wrapper"><h3 class="p-text-size-large p-text-weight-medium is-cp-feature-title">稼働率99.99%のSLO</h3><p class="p-text-size-medium p-text-color-tertiary is-cp-feature-text">トラフィックの急増にも自動スケーリングで対応</p></div></div></div></div><div class="choose-path_image-wrapper is-image-right is-p-bg-pink-subtle-brand"><div class="icon-tagline_card-image-overlay is-horizontal is-left"><div class="p-pixel-row is-stacked"><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block"></div><div class="p-pixel-block"></div><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block"></div><div class="p-pixel-block"></div><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block"></div><div class="p-pixel-block"></div><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block"></div><div class="p-pixel-block"></div><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block is-transparent"></div><div class="p-pixel-block"></div><div class="p-pixel-block"></div><div class="p-pixel-block is-transparent"></div>