agraph","children":[{"type":"text","text":"Flow runs at 37 degrees. Warm enough to soften your body, not so hot you can&#39;t think. You can always step out, cool down, and come back in."}]}]},"iconType":"Chevron","iconPosition":"Trailing","cardScheme":"","isOpen":false,"containerBorder":"Inherit","$index":2,"$count":4}' class="card r-38" data-bind='{"styles":{"breakBefore":"columnBreak"}}'><h3 style="margin: 0"><button class="faq-question-card" type="button" aria-expanded="false" data-onclick='{"type":"run-script","parameters":{"targetId":"31","script":{"mode":"expression","value":"var key = &#39;,&#39; + $trigger.$index + &#39;,&#39;; var open = $b0.indexOf(key) !== -1; if (expandMode === &#39;Multiple&#39;) { $set(\"$b0\", open ? $b0.split(key).join(&#39;,&#39;) : $b0 + $trigger.$index + &#39;,&#39;); } else { $set(\"$b0\", open ? &#39;,&#39; : &#39;,&#39; + $trigger.$index + &#39;,&#39;); }"}}}' data-bind='{"styles":{"justifyContent":"iconPosition === &#39;Leading&#39; ? &#39;flex-start&#39; : &#39;space-between&#39;"},"attrs":{"aria-expanded":"($b0.indexOf(&#39;,&#39; + $index + &#39;,&#39;) !== -1) ? &#39;true&#39; : &#39;false&#39;"}}' style="justify-content: space-between"><div data-cid="39" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"How hot is the room, really?"}]}]},"textSize":"Medium","textWeight":"Strong","contentHorizontalAlignment":"Left","textHeadingSize":"None","textTrim":false,"textColorSource":"Token","maxWidth":"None"}' class="scheme-heading text-style-medium text-weight-strong" data-bind='{"text":"textContent"}'>How hot is the room, really?</div><div class="faq-icon-toggle" data-bind='{"styles":{"transform":"($b0.indexOf(&#39;,&#39; + $index + &#39;,&#39;) !== -1) ? (iconType === &#39;Plus & Minus&#39; ? &#39;rotate(45deg)&#39; : &#39;rotate(180deg)&#39;) : &#39;rotate(0deg)&#39;","order":"iconPosition === &#39;Leading&#39; ? &#39;-1&#39; : &#39;0&#39;"}}' style="transform: rotate(0deg); order: 0"