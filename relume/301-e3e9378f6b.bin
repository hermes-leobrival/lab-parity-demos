","value":"$set(\"$b0\", false)"}}}' data-bind='{"styles":{"pointerEvents":"$b0 ? &#39;auto&#39; : &#39;none&#39;"},"attrs":{"aria-hidden":"$b0 ? &#39;false&#39; : &#39;true&#39;"}}' style="pointer-events: none"></div></div></nav></div>
  <main id="main-content">
    <div id="8f6a9b0f-5aa7-4784-a084-6555b2b1cbb8" data-sid="c" class="page-section"><section class="scheme-1 section-extended anim-timeline"><div class="container content-pane anim-content-recede-fast align-items-start"><div style="display: contents"><div class="grid-content-block-2"><div class="stack fill-height gap-element-xlarge"><div class="stack gap-element-small"><h1 data-cid="f" data-props='{"headingTag":"H1","headingSize":"H1","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Practice in a \nwarmer light"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h1" data-bind='{"text":"headingText"}'>Practice in a 
warmer light</h1></div></div><div class="gap-element-large stack fill-height"><div class="stack"><p data-cid="h" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Aura is a hot yoga house in the heart of Bondi. We teach the roots of the practice, alignment, breath, observation, hands-on care in rooms warmed to meet your body halfway. Stay long enough, and we&#39;ll teach you to teach."}]}]},"paragraphSize":"Medium","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="body-max-width text-style-medium" data-bind='{"text":"paragraphText"}'>Aura is a hot yoga house in the heart of Bondi. We teach the roots of the practice, alignment, breath, observation, hands-on care in rooms warmed to meet your body halfway. Stay long enough, and we'll teach you to teach.</p></div></div></div></div></div><div class="media-pane-overlap"><div class="anim-media-bleed-vertical"><div class="r-i"><div class="media-wrapper media-large media-fill r-j"><video class="media object-cover" autoplay loop muted playsinline poster="/assets/06d8cb47-1dfe-4faa-99f4-36fb486b056b-poster?v=tk9evr"><source class="media object-cover" src="/assets/06d8cb47-1dfe-4faa-99f4-36fb486b056b?v=tk9evr" type="video/mp4"></source></video></div></div></div></div></section></div>
  <div id="f31ca42f-d937-400e-a2cb-e48a1e64fc0a" data-sid="l" class="page-section"><section class="scheme-1 section"><div class="container"><div class="grid-column-2 column-two-three"><div class="stack fill-height stack-center"><div class="stack gap-element-small"><h2 data-cid="n" data-props='{"headingTag":"H2","headingSize":"H2","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Classes small enough to hear you exhale"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-style-h2 heading-max-width" data-bind='{"text":"headingText"}'>Classes small enough to hear you exhale</h2></div><div class="stack gap-element-large"><div class="stack"><p data-cid="o" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Every class runs on a ratio of one teacher to twelve mats. In a warm room that matters, your alignment gets adjusted in the moment, your practice progresses week to week, and nobody spends an hour copying the person in front."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Every class runs on a ratio of one teacher to twelve mats. In a warm room that matters, your alignment gets adjusted in the moment, your practice progresses week to week, and nobody spends an hour copying the person in front.</p></div><div class="button-group"><a data-cid="q" data-props='{"buttonHierarchy":"Secondary","buttonSize":"Regular","buttonHasLeadingIcon":false,"buttonLeadingIcon":"category","buttonHasTrailingIcon":false,"buttonTrailingIcon":"arrow_forward","buttonLabel":"Available classes","buttonLink":"ab40a2461930495084f698c7a3744c94","$index":0,"$count":1}' class="button button-secondary" href="ab40a2461930495084f698c7a3744c94" data-bind='{"attrs":{"href":"buttonLink"}}'><div style="margin: 0">Available classes</div></a></div></div></div><div class="stack fill-height stack-center"><div class="r-r"><div class="media-wrapper media-large aspect-square"><img class="media object-cover" src="/assets/e43ab7b5-c367-473e-bc92-10bed34403cb?v=tk0cnf" srcset="/assets/e43ab7b5-c367-473e-bc92-10bed34403cb-320?v=tk0cnf 320w, /assets/e43ab7b5-c367-473e-bc92-10bed34403cb?v=tk0cnf 606w" sizes="100vw" alt="Back view of a person with closely cropped blond hair, a gold necklace, and bare shoulders against a muted green background." style="aspect-ratio: 606 / 640"></img></div></div></div></div></div></section></div>
  <div id="sc-feature-list-section-vertical" data-sid="u" class="page-section"><section class="scheme-2 section"><div class="container"><div class="stack gap-section-content z-index-1"><div style="display: contents"><div class="grid-content-block-2"><div class="gap-element-large stack fill-height stack-top"><div class="stack gap-element-small"><h2 data-cid="x" data-props='{"headingTag":"H2","headingSize":"H2","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Three ways through\nthe same door."}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-style-h2 heading-max-width" data-bind='{"text":"headingText"}'>Three ways through
the same door.</h2></div></div><div class="gap-element-large stack fill-height"><div class="stack"><div class="stack"><p data-cid="z" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"One door, three rooms. Come for the heat, the quiet, or the cold — and move between them as your body asks."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>One door, three rooms. Come for the heat, the quiet, or the cold — and move between them as your body asks.</p></div></div></div></div></div><div style="display: contents"><div class="grid-column-3"><div class="stack gap-element-large"><div class="row"><div class="r-12"><div class="media-wrapper media-large aspect-square"><img class="media object-cover" src="/assets/8d66fe03-6b7e-43c5-81d5-020b1dca8a7b?v=tk9bdp" srcset="/assets/8d66fe03-6b7e-43c5-81d5-020b1dca8a7b-320?v=tk9bdp 320w, /assets/8d66fe03-6b7e-43c5-81d5-020b1dca8a7b-640?v=tk9bdp 640w, /assets/8d66fe03-6b7e-43c5-81d5-020b1dca8a7b?v=tk9bdp 784w" sizes="100vw" alt="Close-up of dark brown skin with warm sculptural shadows and the white word “flow” centered over it." style="aspect-ratio: 784 / 756"></img></div></div></div><div class="stack gap-element-small"><div class="stack gap-element-small"><h4 data-cid="13" data-props='{"headingTag":"H4","headingSize":"H4","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"flow"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h4" data-bind='{"text":"headingText"}'>flow</h4></div><p data-cid="14" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Hot flow at 37 degrees. The warmth does half the work, muscles soften, joints open, and the practice deepens without force. All levels, always."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Hot flow at 37 degrees. The warmth does half the work, muscles soften, joints open, and the practice deepens without force. All levels, always.</p></div><div class="button-group"><a data-cid="16" data-props='{"buttonHierarchy":"Link","buttonSize":"Regular","buttonHasLeadingIcon":false,"buttonLeadingIcon":"category","buttonHasTrailingIcon":false,"buttonTrailingIcon":"arrow_forward","buttonLabel":"Learn more","buttonLink":"1969762b0ebf4e978f99737608cd813a","$index":0,"$count":1}' class="button button-link" href="1969762b0ebf4e978f99737608cd813a" data-bind='{"attrs":{"href":"buttonLink"}}'><div class="button-link-label" style="margin: 0">Learn more</div></a></div></div><div class="stack gap-element-large"><div class="row"><div class="r-18"><div class="media-wrapper media-large aspect-square"><img class="media object-cover" src="/assets/c1eeabd6-ef26-460d-9337-62462cff67d4?v=tk9bnd" srcset="/assets/c1eeabd6-ef26-460d-9337-62462cff67d4-320?v=tk9bnd 320w, /assets/c1eeabd6-ef26-460d-9337-62462cff67d4-640?v=tk9bnd 640w, /assets/c1eeabd6-ef26-460d-9337-62462cff67d4?v=tk9bnd 784w" sizes="100vw" alt="Close-up of a brown-skinned person with a small tattoo, gold chain, and “Yoga & Breath” text against a sage background." style="aspect-ratio: 784 / 756"></img></div></div></div><div class="stack gap-element-small"><div class="stack gap-element-small"><h4 data-cid="1a" data-props='{"headingTag":"H4","headingSize":"H4","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Yoga & Breath"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h4" data-bind='{"text":"headingText"}'>Yoga &amp; Breath</h4></div><p data-cid="1b" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Slow flow and guided breathwork. The quietest hour of your week, and the one that follows you home. Learn to lower your temperature from the inside."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Slow flow and guided breathwork. The quietest hour of your week, and the one that follows you home. Learn to lower your temperature from the inside.</p></div><div class="button-group"><a data-cid="1d" data-props='{"buttonHierarchy":"Link","buttonSize":"Regular","buttonHasLeadingIcon":false,"buttonLeadingIcon":"category","buttonHasTrailingIcon":false,"buttonTrailingIcon":"arrow_forward","buttonLabel":"Learn more","buttonLink":"1969762b0ebf4e978f99737608cd813a","$index":0,"$count":1}' class="button button-link" href="1969762b0ebf4e978f99737608cd813a" data-bind='{"attrs":{"href":"buttonLink"}}'><div class="button-link-label" style="margin: 0">Learn more</div></a></div></div><div class="stack gap-element-large"><div class="row"><div class="r-1f"><div class="media-wrapper media-large aspect-square"><img class="media object-cover" src="/assets/379a9bcc-8400-496a-8c9f-7d391533e758?v=tk9boj" srcset="/assets/379a9bcc-8400-496a-8c9f-7d391533e758-320?v=tk9boj 320w, /assets/379a9bcc-8400-496a-8c9f-7d391533e758-640?v=tk9boj 640w, /assets/379a9bcc-8400-496a-8c9f-7d391533e758?v=tk9boj 784w" sizes="100vw" alt="Close-up abstract photograph of overlapping brown-skinned body forms with white “Sauna & Plunge” text on a sage background." style="aspect-ratio: 784 / 756"></img></div></div></div><div class="stack gap-element-small"><div class="stack gap-element-small"><h4 data-cid="1h" data-props='{"headingTag":"H4","headingSize":"H4","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Sauna & Plunge"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h4" data-bind='{"text":"headingText"}'>Sauna &amp; Plunge</h4></div><p data-cid="1i" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Sauna, cold plunge and rest. Twenty minutes of heat, three of cold, and the long exhale in between. Bring nothing. Prove nothing."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Sauna, cold plunge and rest. Twenty minutes of heat, three of cold, and the long exhale in between. Bring nothing. Prove nothing.</p></div><div class="button-group"><a data-cid="1k" data-props='{"buttonHierarchy":"Link","buttonSize":"Regular","buttonHasLeadingIcon":false,"buttonLeadingIcon":"category","buttonHasTrailingIcon":false,"buttonTrailingIcon":"arrow_forward","buttonLabel":"Learn more","buttonLink":"1969762b0ebf4e978f99737608cd813a","$index":0,"$count":1}' class="button button-link" href="1969762b0ebf4e978f99737608cd813a" data-bind='{"attrs":{"href":"buttonLink"}}'><div class="button-link-label" style="margin: 0">Learn more</div></a></div></div></div></div></div></div></section></div>
  <div id="eaba3dcc-856b-4962-a97c-1051aa20922c" data-sid="1m" class="page-section"><section class="scheme-1 section"><div class="container"><div class="stack gap-section-content z-index-1"><div class="stack"><div class="stack gap-element-small"><div class="row"><div class="tagline align-center text-align-center"><div>MEMBERSHIP</div></div></div><h2 data-cid="n" data-props='{"headingTag":"H2","headingSize":"H2","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Rewards for showing up"}]}]},"contentHorizontalAlignment":"Center","maxWidth":"Default"}' class="heading-style-h2 heading-max-width align-center text-align-center" data-bind='{"text":"headingText"}'>Rewards for showing up</h2></div><div class="stack gap-element-large"><div class="stack"><p data-cid="o" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"A membership that pays you back for the practice you already keep. The more you come, the more it gives."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Center","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width align-center text-align-center" data-bind='{"text":"paragraphText"}'>A membership that pays you back for the practice you already keep. The more you come, the more it gives.</p></div></div></div><div style="display: contents"><div class="grid-column-card-3"><div class="scheme-2 card card-vertical"><div class="row inset-icon-medium"><div class="r-1r"><span class="icon-wrapper icon-medium icon-color icon-placed-stacked"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' var(--icon-fill-axis), 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">loyalty</span></span></div></div><div class="card-content-medium"><div class="stack gap-element-large fill-height stack-between"><div class="stack gap-element-small"><div class="stack gap-element-small"><h4 data-cid="1t" data-props='{"headingTag":"H4","headingSize":"H4","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Every tenth free"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h4" data-bind='{"text":"headingText"}'>Every tenth free</h4></div><p data-cid="1u" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Ten classes and the eleventh is on us. The longer you stay, the more it gives back."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Center","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Ten classes and the eleventh is on us. The longer you stay, the more it gives back.</p></div></div></div></div><div class="scheme-1 card card-vertical"><div class="row inset-icon-medium"><div class="r-1w"><span class="icon-wrapper icon-medium icon-color icon-placed-stacked"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' var(--icon-fill-axis), 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">sell</span></span></div></div><div class="card-content-medium"><div class="stack gap-element-large fill-height stack-between"><div class="stack gap-element-small"><div class="stack gap-element-small"><h4 data-cid="1y" data-props='{"headingTag":"H4","headingSize":"H4","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Members&#39; rates"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h4" data-bind='{"text":"headingText"}'>Members' rates</h4></div><p data-cid="1z" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Members save on every class and drop-in. Your $30 trial rolls straight into membership."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Center","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Members save on every class and drop-in. Your $30 trial rolls straight into membership.</p></div></div></div></div><div class="scheme-1 card card-vertical"><div class="row inset-icon-medium"><div class="r-21"><span class="icon-wrapper icon-medium icon-color icon-placed-stacked"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' var(--icon-fill-axis), 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">group</span></span></div></div><div class="card-content-medium"><div class="stack gap-element-large fill-height stack-between"><div class="stack gap-element-small"><div class="stack gap-element-small"><h4 data-cid="23" data-props='{"headingTag":"H4","headingSize":"H4","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Bring a friend"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-max-width heading-style-h4" data-bind='{"text":"headingText"}'>Bring a friend</h4></div><p data-cid="24" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Members get guest passes to share with a friend. The community grows one mat."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Center","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Members get guest passes to share with a friend. The community grows one mat.</p></div></div></div></div></div></div></div></div></section></div>
  <div id="sc-testimonial-list-vertical" data-sid="26" class="page-section"><section class="scheme-1 section"><div class="container"><div class="stack gap-section-content z-index-1"><div style="display: contents"><div class="stack"><div class="stack gap-element-small"><h2 data-cid="28" data-props='{"headingTag":"H2","headingSize":"H2","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"One Voice, One Community"}]}]},"contentHorizontalAlignment":"Left","maxWidth":"Default"}' class="heading-style-h2 heading-max-width" data-bind='{"text":"headingText"}'>One Voice, One Community</h2></div></div></div><div style="display: contents"><div class="grid-column-2"><div class="stack gap-element-medium max-width-xl"><div class="row"><div class="r-2b"><div class="media-wrapper media-large"><img class="media object-cover" src="/assets/a870af02-70ed-4136-8ce8-8f0b3c807458?v=tk9ept" srcset="/assets/a870af02-70ed-4136-8ce8-8f0b3c807458-320?v=tk9ept 320w, /assets/a870af02-70ed-4136-8ce8-8f0b3c807458-640?v=tk9ept 640w, /assets/a870af02-70ed-4136-8ce8-8f0b3c807458?v=tk9ept 1208w" sizes="100vw" alt="Close-up portrait of a woman with long dark hair against a sage-green background, labeled “Jessie.”" style="aspect-ratio: 1208 / 912"></img></div></div></div><div class="stack gap-element-medium"><div class="row-between"><div class="star-rating"><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span></div></div><p data-cid="14" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"I walked in terrified of hot yoga and left with a standing Sunday ritual. Nobody ever made me feel like my body was the wrong shape."}]}]},"paragraphSize":"Large","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"None","textTruncate":"None"}' class="text-style-large" data-bind='{"text":"paragraphText"}'>I walked in terrified of hot yoga and left with a standing Sunday ritual. Nobody ever made me feel like my body was the wrong shape.</p><div class="row gap-element-horizontal-medium"><div class="row gap-element-horizontal-small"><div class="stack body-max-width width-auto gap-element-horizontal-micro margin-right-element-tiny" style="flex-wrap: wrap"><div data-cid="2j" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Jessica Wayse"}]}]},"textSize":"Regular","textWeight":"Strong","contentHorizontalAlignment":"Left","textHeadingSize":"None","textTrim":false,"textColorSource":"Token","maxWidth":"None"}' class="text-style-regular scheme-heading text-weight-strong" data-bind='{"text":"textContent"}'>Jessica Wayse</div><div data-cid="2k" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Bondi Beach, Sydney NSW"}]}]},"textSize":"Small","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","textTrim":false,"textColorSource":"Token","maxWidth":"None"}' class="scheme-heading text-style-small" data-bind='{"text":"textContent"}'>Bondi Beach, Sydney NSW</div></div></div></div></div></div><div class="stack gap-element-medium max-width-xl"><div class="row"><div class="r-2m"><div class="media-wrapper media-large"><img class="media object-cover" src="/assets/3c1e729a-90a7-4f0d-9e76-7248c999c226?v=tk9eqd" srcset="/assets/3c1e729a-90a7-4f0d-9e76-7248c999c226-320?v=tk9eqd 320w, /assets/3c1e729a-90a7-4f0d-9e76-7248c999c226-640?v=tk9eqd 640w, /assets/3c1e729a-90a7-4f0d-9e76-7248c999c226?v=tk9eqd 1208w" sizes="100vw" alt="Close-up side profile of a blonde woman with closed eyes against a muted sage-green background, labeled “Amelia.”" style="aspect-ratio: 1208 / 912"></img></div></div></div><div class="stack gap-element-medium"><div class="row-between"><div class="star-rating"><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span><span class="icon-wrapper icon-color icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' 1, 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">star</span></span></div></div><p data-cid="2u" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"I came for the heat. I stayed because my teacher knew my name, and my stubborn left hamstring, by the second week. Would totally recommend to anyone"}]}]},"paragraphSize":"Large","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","maxWidth":"None","textTruncate":"None"}' class="text-style-large" data-bind='{"text":"paragraphText"}'>I came for the heat. I stayed because my teacher knew my name, and my stubborn left hamstring, by the second week. Would totally recommend to anyone</p><div class="row gap-element-horizontal-medium"><div class="row gap-element-horizontal-small"><div class="stack body-max-width width-auto gap-element-horizontal-micro margin-right-element-tiny" style="flex-wrap: wrap"><div data-cid="2w" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Amelia Haywood"}]}]},"textSize":"Regular","textWeight":"Strong","contentHorizontalAlignment":"Left","textHeadingSize":"None","textTrim":false,"textColorSource":"Token","maxWidth":"None"}' class="text-style-regular scheme-heading text-weight-strong" data-bind='{"text":"textContent"}'>Amelia Haywood</div><div data-cid="2x" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Bondi Beach, Sydney NSW"}]}]},"textSize":"Small","textWeight":"Regular","contentHorizontalAlignment":"Left","textHeadingSize":"None","textTrim":false,"textColorSource":"Token","maxWidth":"None"}' class="scheme-heading text-style-small" data-bind='{"text":"textContent"}'>Bondi Beach, Sydney NSW</div></div></div></div></div></div></div></div></div></div></section></div>
  <div id="42a5edf3-b5e2-4356-8d9b-9924f8b5a7e3" data-sid="2z" data-state='{"b0":","}' class="page-section"><section class="scheme-1 section"><div class="container"><div class="stack gap-section-content z-index-1"><div class="stack"><div class="stack gap-element-small"><div class="row"><div class="tagline align-center text-align-center"><div>GOOD TO ASK</div></div></div><h2 data-cid="n" data-props='{"headingTag":"H2","headingSize":"H2","headingText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"FAQs"}]}]},"contentHorizontalAlignment":"Center","maxWidth":"Default"}' class="heading-style-h2 heading-max-width align-center text-align-center" data-bind='{"text":"headingText"}'>FAQs</h2></div><div class="stack gap-element-large"><div class="stack"><p data-cid="o" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"A few things people ask before their first class. If yours isn&#39;t here, just ask — we&#39;re happy to talk."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Center","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width align-center text-align-center" data-bind='{"text":"paragraphText"}'>A few things people ask before their first class. If yours isn't here, just ask — we're happy to talk.</p></div></div></div><div style="display: contents"><div data-cid="31" data-props='{"items":[{"faqQuestion":"Question text goes here","faqAnswer":"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla."},{"faqQuestion":"Question text goes here","faqAnswer":"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla."},{"faqQuestion":"Question text goes here","faqAnswer":"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla."},{"faqQuestion":"Question text goes here","faqAnswer":"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Suspendisse varius enim in eros elementum tristique. Duis cursus, mi quis viverra ornare, eros dolor interdum nulla."}],"cardScheme":"","expandMode":"Single","iconPosition":"Trailing","iconType":"Chevron","contentHorizontalAlignment":"Center","containerBorder":"Inherit"}' class="faq-list-card max-width-xl"><div data-cid="32" data-props='{"columnBreak":"auto","faqQuestion":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"I&#39;ve never done hot yoga. Will I be able to keep up?"}]}]},"faqAnswer":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Every class runs on a ratio of one teacher to twelve mats, all levels, always. You set your own pace, rest whenever you need to, and your alignment gets adjusted in the moment — nobody spends an hour copying the person in front."}]}]},"iconType":"Chevron","iconPosition":"Trailing","cardScheme":"","isOpen":false,"containerBorder":"Inherit","$index":0,"$count":4}' class="card r-32" data-bind='{"styles":{"breakBefore":"columnBreak"}}'><h3 style="margin: 0"><button class="faq-question-card" type="button" aria-expanded="false" data-onclick='{"type":"run-script","parameters":{"targetId":"31","script":{"mode":"expression","value":"var key = &#39;,&#39; + $trigger.$index + &#39;,&#39;; var open = $b0.indexOf(key) !== -1; if (expandMode === &#39;Multiple&#39;) { $set(\"$b0\", open ? $b0.split(key).join(&#39;,&#39;) : $b0 + $trigger.$index + &#39;,&#39;); } else { $set(\"$b0\", open ? &#39;,&#39; : &#39;,&#39; + $trigger.$index + &#39;,&#39;); }"}}}' data-bind='{"styles":{"justifyContent":"iconPosition === &#39;Leading&#39; ? &#39;flex-start&#39; : &#39;space-between&#39;"},"attrs":{"aria-expanded":"($b0.indexOf(&#39;,&#39; + $index + &#39;,&#39;) !== -1) ? &#39;true&#39; : &#39;false&#39;"}}' style="justify-content: space-between"><div data-cid="33" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"I&#39;ve never done hot yoga. Will I be able to keep up?"}]}]},"textSize":"Medium","textWeight":"Strong","contentHorizontalAlignment":"Left","textHeadingSize":"None","textTrim":false,"textColorSource":"Token","maxWidth":"None"}' class="scheme-heading text-style-medium text-weight-strong" data-bind='{"text":"textContent"}'>I've never done hot yoga. Will I be able to keep up?</div><div class="faq-icon-toggle" data-bind='{"styles":{"transform":"($b0.indexOf(&#39;,&#39; + $index + &#39;,&#39;) !== -1) ? (iconType === &#39;Plus & Minus&#39; ? &#39;rotate(45deg)&#39; : &#39;rotate(180deg)&#39;) : &#39;rotate(0deg)&#39;","order":"iconPosition === &#39;Leading&#39; ? &#39;-1&#39; : &#39;0&#39;"}}' style="transform: rotate(0deg); order: 0"><span class="icon-wrapper icon-small"><span style="line-height: 1; font-variation-settings: 'wght' var(--icon-weight), 'FILL' var(--icon-fill-axis), 'GRAD' 0, 'opsz' 24; font-family: var(--icon-font-family)">keyboard_arrow_down</span></span></div></button></h3><div class="faq-answer" data-bind='{"styles":{"gridTemplateRows":"($b0.indexOf(&#39;,&#39; + $index + &#39;,&#39;) !== -1) ? &#39;1fr&#39; : &#39;0fr&#39;"}}' style="grid-template-rows: 0fr"><div class="faq-answer-inner"><div class="faq-answer-body-card"><p data-cid="34" data-props='{"paragraphText":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"Every class runs on a ratio of one teacher to twelve mats, all levels, always. You set your own pace, rest whenever you need to, and your alignment gets adjusted in the moment — nobody spends an hour copying the person in front."}]}]},"paragraphSize":"Regular","textWeight":"Regular","contentHorizontalAlignment":"Center","textHeadingSize":"None","maxWidth":"Default","textTruncate":"None"}' class="text-style-regular body-max-width" data-bind='{"text":"paragraphText"}'>Every class runs on a ratio of one teacher to twelve mats, all levels, always. You set your own pace, rest whenever you need to, and your alignment gets adjusted in the moment — nobody spends an hour copying the person in front.</p></div></div></div></div><div data-cid="35" data-props='{"columnBreak":"auto","faqQuestion":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"I&#39;m not flexible. Is this for someone like me?"}]}]},"faqAnswer":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"You don&#39;t need to be flexible to start. The warmth does half the work — muscles soften, joints open, and the practice deepens without force. Come as you are."}]}]},"iconType":"Chevron","iconPosition":"Trailing","cardScheme":"","isOpen":false,"containerBorder":"Inherit","$index":1,"$count":4}' class="card r-35" data-bind='{"styles":{"breakBefore":"columnBreak"}}'><h3 style="margin: 0"><button class="faq-question-card" type="button" aria-expanded="false" data-onclick='{"type":"run-script","parameters":{"targetId":"31","script":{"mode":"expression","value":"var key = &#39;,&#39; + $trigger.$index + &#39;,&#39;; var open = $b0.indexOf(key) !== -1; if (expandMode === &#39;Multiple&#39;) { $set(\"$b0\", open ? $b0.split(key).join(&#39;,&#39;) : $b0 + $trigger.$index + &#39;,&#39;); } else { $set(\"$b0\", open ? &#39;,&#39; : &#39;,&#39; + $trigger.$index + &#39;,&#39;); }"}}}' data-bind='{"styles":{"justifyContent":"iconPosition === &#39;Leading&#39; ? &#39;flex-start&#39; : &#39;space-between&#39;"},"attrs":{"aria-expanded":"($b0.indexOf(&#39;,&#39; + $index + &#39;,&#39;) !== -1) ? &#39;true&#39; : &#39;false&#39;"}}' style="justify-content: space-between"><div data-cid="36" data-props='{"textContent":{"blocks":[{"type":"paragraph","children":[{"type":"text","text":"I&#39;m not flexible. Is this for someone like me?"}]}]},"textSize":"Medium","textWeight":"Strong","contentHorizontalAlignment":"Left","textHeadingSi