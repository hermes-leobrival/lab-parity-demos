<!-- Mobile hero: skip the page-load fade on the text block
     On phones the hero text (badge, heading, paragraph, avatars, buttons) is hidden by the
     Webflow page-load interaction until webflow.js has downloaded and run, which is what
     drives the 7s Speed Index in Lighthouse. This forces those five elements visible on
     mobile/landscape (<=767px) so the text paints immediately; the mockup grid still animates.
     Desktop/tablet are unchanged. To restore the mobile animation, delete this block. -->
<style>
@media screen and (max-width: 767px) {
  .section_heroheader .heroheader_content-wrapper .margin-bottom.margin-xsmall,
  .section_heroheader .heroheader_heading,
  .section_heroheader .heroheader_content-wrapper .text-size-large,
  .section_heroheader .heroheader_content-wrapper .margin-top.margin-small,
  .section_heroheader .heroheader_content-wrapper .button-row {
    opacity: 1 !important;
    transform: none !important;
  }
}
