  drop-shadow(0px 4px 4px rgba(0, 0, 0, 0.03)) 
  drop-shadow(0px 2px 1px rgba(0, 0, 0, 0.04));
  pointer-events: none;
}
.shadow-xlarge-drop {
	filter: drop-shadow(0px 20px 20px rgba(0, 0, 0, 0.08)) 
