}

.show-more_wrapper-overlay {
    position: absolute;
    top: auto;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(255, 255, 255, 1); /* Fallback color */
    z-index: 10;
    
    /* Linear fade-in effect from the bottom */
    mask-image: linear-gradient(to top, black 30%, transparent 100%);
    -webkit-mask-image: linear-gradient(to top, black 30%, transparent 100%); /* Safari support */
}

.typed-cursor {
    color: #6941C6;
    font-weight: semibold;
}

a:focus-visible, 
button:focus-visible { 
  outline: 2px solid rgb(158 119 237) /* brand-500 */; 
