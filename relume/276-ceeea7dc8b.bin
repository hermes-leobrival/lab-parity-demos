/* Snippet improves best practices score for object-fit:cover images*/
img {
    overflow:clip !important
}

/* Snippet gets rid of top margin on first element in any rich text*/
.w-richtext>:first-child {
	margin-top: 0;
}

/* Snippet gets rid of bottom margin on last element in any rich text*/
.w-richtext>:last-child, .w-richtext ol li:last-child, .w-richtext ul li:last-child {
    margin-bottom: 0;
}

/* Snippet makes all link elements listed below to inherit color from their parent */
a, 
.w-tab-link,
.w-nav-link,
.w-dropdown-btn,
.w-dropdown-toggle,
.w-dropdown-link
{
color: inherit;
}

/* Snippet prevents all click and hover interaction with an element */
.clickable-off {
  pointer-events: none;
}

/* Snippet enables all click and hover interaction with an element */
.clickable-on{
  pointer-events: auto;
}

/* Snippet prevents all click and hover interaction on tooltips */
.tooltip_icon-message {
  pointer-events: none;
}

/* Snippet enables you to add class of div-square which creates and maintains a 1:1 dimension of a div.*/
.div-square::after {
  content: "";
  display: block;
  padding-bottom: 100%;
}

/*Hide focus outline for main content element*/
    main:focus-visible {
    outline: -webkit-focus-ring-color auto 0px;
}

/* Make sure containers never lose their center alignment*/
.container-small, .container-medium, .container-large {
  margin-right: auto !important;
  margin-left: auto !important;
}

/*Reset selects, buttons, and links styles*/
.w-input, .w-select, a {
color: inherit;
text-decoration: inherit;
font-size: inherit;
}

/*Apply "..." after 3 lines of text */
.text-style-3lines {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
}

/* Apply "..." after 2 lines of text */
.text-style-2lines {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
}

/* Apply "..." after 1 line of text */
.text-style-1line {
    display: -webkit-box;
    overflow: hidden;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
}

/* Balance line wraps evenly */
.text-balance {
    text-wrap: balance;
}
@media screen and (min-width: 992px) {
  .text-balance-desktop {
    text-wrap: balance;
  }
}

.text-style-monospace {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
}

.text-style-code, code {
  font-family: ui-monospace, "Roboto Mono", SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  padding: 2px 6px;
  border-radius: 6px;
  font-size: 0.875rem;
  line-height: 1.25rem;
  white-space: nowrap;
  font-weight: 700;
  color: #525252;
  background-color: #fafafa;
  border: 0;
  box-shadow: inset 0 0 0 1px #e5e5e5;
}
@media (max-width: 767px) {
  .text-style-code, code { white-space: normal; word-break: break-all; }
}

.w-richtext .code-block { margin: 24px 0; border: 1px solid #e9eaeb; border-radius: 12px; background: #fafafa; overflow: hidden; }
.w-richtext .code-block__bar { display: flex; align-items: center; justify-content: space-between; padding: 6px 8px 6px 16px; border-bottom: 1px solid #e9eaeb; background: #fff; font: 600 12px/18px Inter, sans-serif; color: #414651; }
.w-richtext .code-block__copy { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border: 1px solid #d5d7da; border-radius: 8px; background: #fff; font: 600 12px/18px Inter, sans-serif; color: #414651; cursor: pointer; box-shadow: 0 1px 2px rgba(10,13,18,.05); }
.w-richtext .code-block__copy:hover { background: #fafafa; }
.w-richtext .code-block pre { margin: 0; padding: 16px 20px; overflow-x: auto; background: none; border: 0; }
.w-richtext .code-block code { display: block; white-space: pre; word-break: normal; background: none; border: 0; box-shadow: none; padding: 0; border-radius: 0; font: 14px/1.7 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; color: #414651; tab-size: 2; }
.w-richtext .code-block .token.comment { color: #717680; font-style: italic; }
.w-richtext .code-block .token.keyword, .w-richtext .code-block .token.attr-name { color: #6941c6; }
.w-richtext .code-block .token.tag, .w-richtext .code-block .token.selector { color: #175cd3; }
.w-richtext .code-block .token.string, .w-richtext .code-block .token.attr-value { color: #067647; }
.w-richtext .code-block .token.function, .w-richtext .code-block .token.property { color: #b54708; }
.w-richtext .code-block .token.punctuation, .w-richtext .code-block .token.operator { color: #535862; }

/* Apply "..." at 100% width */
.truncate-width { 
		width: 100%; 
    white-space: nowrap; 
    overflow: hidden; 
    text-overflow: ellipsis; 
}

/* Removes native scrollbar */
.no-scrollbar {
  -ms-overflow-style: none;        /* IE 10+ */
  scrollbar-width: none;           /* Firefox — the modern property */
  overscroll-behavior-x: none;     /* stops the rubber-band white space */
}
.no-scrollbar::-webkit-scrollbar {
  display: none;                   /* Safari and Chrome */
}

/* Overflow clip horizontal scroll */
.page-wrapper {
    overflow: clip;
}

body:hover .cursor_component {opacity:1.0;}
.cursor_component {pointer-events: none;}

.hero-header_cursor-pointer {
  -webkit-filter: drop-shadow(0px 3px 6px rgba(0, 0, 0, 0.12));
