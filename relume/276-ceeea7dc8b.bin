} 
.user-pointer-02_pointer {
  -webkit-filter: drop-shadow(0px 3px 6px rgba(0, 0, 0, 0.12));
  filter: drop-shadow(0px 3px 6px rgba(0, 0, 0, 0.12));
  pointer-events: none;
} 

.shadow-medium-drop {
	filter: drop-shadow(0px 4px 5px rgba(0, 0, 0, 0.08)) 
  drop-shadow(0px 2px 2px rgba(0, 0, 0, 0.04));
